# Provision the view's session token once Selkies answers, before OnDemand
# reports the session running; a session that never comes up ends the job.
# curl reads both tokens from its standard input, since every account on the
# node can list its command line, and sends them to the node itself rather
# than to a proxy the environment names.
if wait_until_port_used "${host}:${port}" 120; then
  curl -fsS -o /dev/null --config - <<SELKIES_TOKENS || clean_up 1
url = "http://${host}:${port}/api/tokens"
noproxy = "*"
header = "Authorization: Bearer ${SELKIES_MASTER_TOKEN}"
header = "Content-Type: application/json"
data = {"${password}":{"role":"controller","slot":1}}
SELKIES_TOKENS
else
  clean_up 1
fi
