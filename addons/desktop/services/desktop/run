#!/bin/bash
# This Source Code Form is subject to the terms of the Mozilla Public
# License, v. 2.0. If a copy of the MPL was not distributed with this
# file, You can obtain one at https://mozilla.org/MPL/2.0/.
#
# The desktop shell, selkies-desktop, on whichever backend the session runs:
# over the nested labwc the base's wayland service starts, or over the Openbox
# the openbox service starts on X11. It runs on a session bus of its own, which
# every application it launches inherits and Selkies adopts for the commands
# it launches into the session.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/runtime-ubuntu}"
until [ -f "${XDG_RUNTIME_DIR}/container-env" ]; do sleep 0.5; done
# shellcheck disable=SC1091  # written by container-entrypoint.sh at startup
. "${XDG_RUNTIME_DIR}/container-env"
# What the desktop launches starts in its directory: the home, not this service's.
cd "${HOME}" || true
shopt -s nullglob

# Canonicalized by container-entrypoint.sh, so one spelling is enough here.
if [ "${SELKIES_WAYLAND:-false}" = "true" ]; then
  # The shell belongs to the nested compositor, whose layer shell it anchors to
  # and whose XWayland server carries the system tray. Its socket is the one
  # the wayland service did not record as the capture compositor's, and both it
  # and the display are discovered here — the inherited values name what a
  # shell attached to the container should use, not what is up yet.
  unset DISPLAY WAYLAND_DISPLAY
  until [ -f "${XDG_RUNTIME_DIR}/selkies-capture-display" ]; do sleep 0.5; done
  capture="$(cat "${XDG_RUNTIME_DIR}/selkies-capture-display")"
  # Each socket sits beside a wayland-N.lock of the same stem, so only sockets
  # count here
  until [ -n "${WAYLAND_DISPLAY}" ]; do
    sleep 0.5
    for socket in "${XDG_RUNTIME_DIR}"/wayland-[0-9]*; do
      [ -S "${socket}" ] && [ "${socket##*/}" != "${capture}" ] \
        && WAYLAND_DISPLAY="${socket##*/}" && break
    done
  done
  export WAYLAND_DISPLAY
  # XWayland takes the first free display number, and no other X server runs on
  # this backend
  until [ -n "${DISPLAY}" ]; do
    sleep 0.5
    for socket in /tmp/.X11-unix/X[0-9]*; do
      [ -S "${socket}" ] && DISPLAY=":${socket##*/X}" && break
    done
  done
  export DISPLAY
  # selkies-desktop sets the titlebar's button side and corner radius in labwc's
  # user rc.xml, the only one it edits, so the session gets one: the image's
  # system file, copied afresh on every start so an image update reaches it.
  # The marker is what makes a copy this script's; a file without it is the
  # user's own and left alone. The shell's first edit of the copy reloads labwc,
  # which then reads it in place of the system file.
  labwc_rc="${XDG_CONFIG_HOME:-${HOME}/.config}/labwc/rc.xml"
  marker="<!-- copied from /etc/xdg/labwc/rc.xml at every desktop start; remove this line to keep your own edits -->"
  if [ ! -e "${labwc_rc}" ] || grep -qF -- "${marker}" "${labwc_rc}"; then
    mkdir -p "${labwc_rc%/*}"
    { head -n 1 /etc/xdg/labwc/rc.xml; echo "${marker}"; tail -n +2 /etc/xdg/labwc/rc.xml; } > "${labwc_rc}"
  fi
else
  export DISPLAY="${DISPLAY:-:20}"
  until [ -S "/tmp/.X11-unix/X${DISPLAY#*:}" ]; do sleep 0.5; done
  # The shell themes the window manager it finds running when it starts, so it
  # waits for Openbox to claim the screen, and starts without it after a while
  # rather than leave a session with no desktop at all.
  for _ in $(seq 40); do
    xprop -display "${DISPLAY}" -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -q 'window id' && break
    sleep 0.5
  done
fi
# The home's Desktop, Documents, Downloads, and the other standard folders the
# shell's file manager lists and its desktop maps launchers from: the one XDG
# autostart entry the image carries, which no session manager runs here.
xdg-user-dirs-update 2>/dev/null || true
echo "[desktop] selkies-desktop on ${WAYLAND_DISPLAY:-${DISPLAY}}"
exec dbus-launch --exit-with-session selkies-desktop
