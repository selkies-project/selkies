# Dashboard-facing wrapper around proot-apps (linuxserver.io): the apps panel
# posts `selkies-proot install|remove|update <app>` through the server's
# command channel. proot-apps runs its whole toolchain (proot, jq, ncat) from
# ~/.local/bin by absolute path, so the image's staging directory is linked
# there before delegating -- linked rather than copied, because a copy drops
# the extended attribute the capability-carrying proot below is built on.

set -eu

staging="/opt/proot-apps"
capable="/opt/proot-apps-cap/proot"
bin="${HOME}/.local/bin"

if [ -d "${staging}" ]; then
    mkdir -p "${bin}"
    for tool in "${staging}"/*; do
        ln -sfn "${tool}" "${bin}/$(basename "${tool}")"
    done
    # proot traces every process it starts, so on a host that restricts ptrace
    # only the copy carrying CAP_SYS_PTRACE can run anything. That copy cannot
    # even exec where the container's bounding set lacks the capability, so
    # which one works is settled by running it.
    if [ -x "${capable}" ] && "${capable}" -0 /bin/true > /dev/null 2>&1; then
        ln -sfn "${capable}" "${bin}/proot"
    fi
fi

# proot traces every process it starts, so a host that denies ptrace leaves
# nothing for the panel to install or launch.
proot_runs() {
    [ -x "${bin}/proot" ] && "${bin}/proot" -0 /bin/true > /dev/null 2>&1
}

explain_denial() {
    scope="$(cat /proc/sys/kernel/yama/ptrace_scope 2>/dev/null || echo unknown)"
    bounding="$(grep CapBnd /proc/self/status 2>/dev/null | cut -f2)"
    echo "selkies-proot: proot cannot ptrace here, so no app can install or run." >&2
    echo "  kernel.yama.ptrace_scope=${scope}, container CapBnd=${bounding}" >&2
    echo "  Grant the container CAP_SYS_PTRACE, or lower the sysctl on the host." >&2
}

# proot-apps files every app icon under the theme's `scalable` directory
# whatever its format, and gtk-update-icon-cache indexes no raster there: the
# cache it then writes is empty, and a desktop that trusts a cache over the
# directory behind it (Qt reads one, so LXQt does) draws no icon at all. The
# icons are put where their size says they belong and the cache rebuilt from
# that, which also leaves the theme laid out the way the spec describes.
data_home="${XDG_DATA_HOME:-${HOME}/.local/share}"
theme="${data_home}/icons/hicolor"

png_width() {
    # IHDR width: four big-endian bytes at offset 16 of any PNG.
    od -An -N4 -j16 -tu4 --endian=big "$1" 2>/dev/null | tr -d ' \n'
}

theme_dir_for() {
    # The listed square directory closest to $1 pixels; empty when none fits.
    best="" diff_best=""
    for size in 512 256 192 128 96 72 64 48 36 32 24 22 16; do
        grep -q "^\[${size}x${size}/apps\]" "${theme}/index.theme" 2>/dev/null || continue
        diff=$(( $1 > size ? $1 - size : size - $1 ))
        if [ -z "${diff_best}" ] || [ "${diff}" -lt "${diff_best}" ]; then
            best="${size}" diff_best="${diff}"
        fi
    done
    [ -n "${best}" ] && echo "${best}x${best}/apps"
}

sort_icons() {
    [ -d "${theme}/scalable/apps" ] || return 0
    for icon in "${theme}"/scalable/apps/*.png; do
        [ -f "${icon}" ] || continue
        width="$(png_width "${icon}")"
        [ -n "${width}" ] && [ "${width}" -gt 0 ] 2>/dev/null || continue
        dir="$(theme_dir_for "${width}")"
        [ -n "${dir}" ] || continue
        mkdir -p "${theme}/${dir}"
        mv -f "${icon}" "${theme}/${dir}/"
    done
    # An icon whose app is gone would otherwise outlive it, since proot-apps
    # deletes only the copy it filed itself.
    for icon in "${theme}"/*x*/apps/*.png; do
        [ -f "${icon}" ] || continue
        name="$(basename "${icon}" .png)"
        grep -qs "^Icon=${name}$" "${data_home}"/applications/*.desktop || rm -f "${icon}"
    done
    command -v gtk-update-icon-cache > /dev/null 2>&1 &&
        gtk-update-icon-cache -f -t "${theme}" > /dev/null 2>&1
    return 0
}

# `check` is what the server asks before telling clients the apps panel is
# usable; the rest is answered here rather than as a failed unpack several
# hundred megabytes later.
case "${1:-}" in
    check)
        proot_runs && exit 0
        explain_denial
        exit 1
        ;;
    install|update|run|get)
        if ! proot_runs; then
            explain_denial
            exit 1
        fi
        ;;
esac

case "${1:-}" in
    install|update|remove)
        status=0
        "${bin}/proot-apps" "$@" || status=$?
        sort_icons
        exit "${status}"
        ;;
esac

exec "${bin}/proot-apps" "$@"
