#
# The Applications submenu of the window managers' right-click menu: an
# Openbox pipe menu, which labwc reads in the same format, listing the
# installed applications by category. It is generated each time the menu opens,
# so an application installed in the session, from apt or the apps panel, is
# there on the next right click without a reconfigure.
#
# It reads the desktop entries the way selkies-desktop's start menu does, so
# the two list the same applications under the same categories: the user's
# applications directory first, then each of XDG_DATA_DIRS, the first entry of
# a desktop file ID winning, so an override under /usr/local/share or the home
# hides or replaces a packaged one; entries that are not applications, are
# NoDisplay or Hidden, or name a TryExec that is not installed are left out;
# and an entry's category is the first of the start menu's mapping its
# Categories list names, in the mapping's order, with "Other" for the rest and
# listed last. Terminal=true entries open in x-terminal-emulator.
#
# `--icons` adds each entry's icon by theme name, which labwc resolves itself;
# Openbox takes only a file path there, so its menu goes without.
set -eu

icons=no
[ "${1:-}" = "--icons" ] && icons=yes

set --
for dir in "${XDG_DATA_HOME:-${HOME}/.local/share}" $(printf '%s' "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" | tr ':' ' '); do
  for entry in "${dir}"/applications/*.desktop; do
    [ -f "${entry}" ] && set -- "$@" "${entry}"
  done
done

echo '<openbox_pipe_menu>'
if [ "$#" -gt 0 ]; then
  lang="${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}"
  lang="${lang%%.*}"
  lang="${lang%%@*}"
  awk -v lang="${lang}" -v short="${lang%%_*}" -v path="${PATH}" '
    function flush(   cat, i, n, listed, k) {
      if (id == "" || type != "Application" || hidden == "true" || nodisplay == "true" || exec == "") return
      if (tryexec != "" && !installed(tryexec)) return
      name = name_lang != "" ? name_lang : (name_short != "" ? name_short : name_plain)
      if (name == "") return
      gsub(/ ?%[fFuUdDnNickvm]/, "", exec)
      gsub(/%%/, "%", exec)
      if (terminal == "true") exec = "x-terminal-emulator -e " exec
      cat = ""
      n = split(categories, listed, ";")
      for (k = 1; k <= nmap && cat == ""; k++)
        for (i = 1; i <= n; i++)
          if (listed[i] == from[k]) { cat = to[k]; break }
      # The leading digit sorts Other after every named category
      if (cat == "") cat = "1Other"; else cat = "0" cat
      gsub(/\t/, " ", name)
      gsub(/\t/, " ", exec)
      printf "%s\t%s\t%s\t%s\n", cat, name, exec, icon
    }
    function installed(program,   dirs, n, i) {
      if (program ~ /^\//) return system("test -x \"" program "\"") == 0
      n = split(path, dirs, ":")
      for (i = 1; i <= n; i++)
        if (dirs[i] != "" && system("test -x \"" dirs[i] "/" program "\"") == 0) return 1
      return 0
    }
    BEGIN {
      nmap = split("AudioVideo Audio Video Development Education Game Graphics Network WebBrowser Office Science Settings System Utility TerminalEmulator FileManager", from, " ")
      split("Multimedia Multimedia Multimedia Development Education Games Graphics Internet Internet Office Science Settings System Utilities System System", to, " ")
    }
    FNR == 1 {
      flush()
      file = FILENAME
      sub(/.*\//, "", file)
      id = (file in seen) ? "" : file
      seen[file] = 1
      group = ""
      type = name_plain = name_lang = name_short = exec = tryexec = terminal = categories = icon = nodisplay = hidden = ""
    }
    id == "" { next }
    /^\[/ { group = $0; next }
    group != "[Desktop Entry]" { next }
    {
      eq = index($0, "=")
      if (eq == 0) next
      key = substr($0, 1, eq - 1)
      value = substr($0, eq + 1)
      sub(/[ \t]+$/, "", key)
      sub(/^[ \t]+/, "", value)
      if (key == "Type") type = value
      else if (key == "Name") name_plain = value
      else if (lang != "" && key == "Name[" lang "]") name_lang = value
      else if (short != "" && key == "Name[" short "]") name_short = value
      else if (key == "Exec") exec = value
      else if (key == "TryExec") tryexec = value
      else if (key == "Terminal") terminal = value
      else if (key == "Categories") categories = value
      else if (key == "Icon") icon = value
      else if (key == "NoDisplay") nodisplay = value
      else if (key == "Hidden") hidden = value
    }
    END { flush() }
  ' "$@" | LC_ALL=C sort -t "$(printf '\t')" -k1,1 -k2,2f | awk -F '\t' -v icons="${icons}" '
    function xml(s) {
      gsub(/&/, "\\&amp;", s)
      gsub(/</, "\\&lt;", s)
      gsub(/>/, "\\&gt;", s)
      gsub(/"/, "\\&quot;", s)
      return s
    }
    {
      cat = substr($1, 2)
      if (cat != current) {
        if (current != "") print "</menu>"
        printf "<menu id=\"selkies-applications-%s\" label=\"%s\">\n", xml(cat), xml(cat)
        current = cat
      }
      attr = (icons == "yes" && $4 != "") ? " icon=\"" xml($4) "\"" : ""
      printf "<item label=\"%s\"%s><action name=\"Execute\"><command>%s</command></action></item>\n", xml($2), attr, xml($3)
    }
    END { if (current != "") print "</menu>" }
  '
fi
echo '</openbox_pipe_menu>'
