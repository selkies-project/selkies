#
# The one terminal entry in the start menu, opening foot on Wayland and
# xfce4-terminal on X11 through selkies-terminal. The terminals' own entries
# are hidden by overrides beside this one, since each runs on one backend.
[Desktop Entry]
Type=Application
Name=Terminal
Comment=Use the command line
Exec=selkies-terminal
Icon=utilities-terminal
Terminal=false
Categories=System;TerminalEmulator;
Keywords=shell;prompt;command;commandline;cmd;foot;xfce4-terminal;
