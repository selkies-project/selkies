#
# The image's desktop as one session, for a session file or the
# x-session-manager to start: the window manager for the backend the session
# is started on, with selkies-desktop as its startup command. The session
# lasts as long as the window manager does, as a display manager expects, and
# the image's own services run the same pair under s6 instead.
if [ "${XDG_SESSION_TYPE:-}" = "wayland" ]; then
  exec labwc --startup selkies-desktop
fi
exec openbox --startup selkies-desktop
