#
# The image's desktop as one session, for a session file or the
# x-session-manager to start. The server runs the window manager and the
# selkies-desktop shell itself under SELKIES_DESKTOP, so the session has
# nothing of its own to start: it lasts as long as the shell the server runs,
# which is the session's end as a display manager expects one.
until pgrep -x selkies-desktop > /dev/null 2>&1; do sleep 0.5; done
while pgrep -x selkies-desktop > /dev/null 2>&1; do sleep 2; done
