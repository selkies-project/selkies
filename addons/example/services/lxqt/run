#!/bin/bash
# This Source Code Form is subject to the terms of the Mozilla Public
# License, v. 2.0. If a copy of the MPL was not distributed with this
# file, You can obtain one at https://mozilla.org/MPL/2.0/.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/runtime-ubuntu}"
until [ -f "${XDG_RUNTIME_DIR}/container-env" ]; do sleep 0.5; done
# shellcheck disable=SC1091  # written by container-entrypoint.sh at startup
. "${XDG_RUNTIME_DIR}/container-env"
shopt -s nullglob

# Canonicalized by container-entrypoint.sh, so one spelling is enough here.
if [ "${SELKIES_WAYLAND:-false}" = "true" ]; then
  # The session belongs to the nested compositor: it manages the windows and
  # runs the XWayland server the LXQt components draw on. Its socket is the one
  # the wayland service did not record as the capture compositor's, and both it
  # and the display are discovered here — the inherited values name what a shell
  # attached to the container should use, not what is up yet.
  unset DISPLAY WAYLAND_DISPLAY
  until [ -f "${XDG_RUNTIME_DIR}/selkies-capture-display" ]; do sleep 0.5; done
  capture="$(cat "${XDG_RUNTIME_DIR}/selkies-capture-display")"
  # Each socket sits beside a wayland-N.lock of the same stem, so only sockets
  # count here
  until [ -n "${WAYLAND_DISPLAY}" ]; do
    sleep 0.5
    for socket in "${XDG_RUNTIME_DIR}"/wayland-[0-9]*; do
      [ -S "${socket}" ] && [ "${socket##*/}" != "${capture}" ] \
        && WAYLAND_DISPLAY="${socket##*/}" && break
    done
  done
  export WAYLAND_DISPLAY
  # XWayland takes the first free display number, and no other X server runs on
  # this backend
  until [ -n "${DISPLAY}" ]; do
    sleep 0.5
    for socket in /tmp/.X11-unix/X[0-9]*; do
      [ -S "${socket}" ] && DISPLAY=":${socket##*/X}" && break
    done
  done
  export DISPLAY
  # Window management belongs to the nested compositor; LXQt starting one of its
  # own would find the selection taken and leave the session half-built
  session_wm=/bin/true
  # A panel and a desktop are shell surfaces: they have to anchor to an edge and
  # reserve space, which on Wayland means wlr-layer-shell. LXQt grew that in 2.1,
  # and a distribution that packages `startlxqtwayland` is one that carries it —
  # so that binary and a Qt Wayland plugin together are what decides. With both,
  # the session runs natively on the nested compositor, given the environment
  # startlxqtwayland would have exported (the compositor itself is already up, so
  # only the environment is wanted, not its exec). With either missing, Qt finds
  # no Wayland plugin to load and reaches the compositor's XWayland by itself,
  # which is where a session predating layer-shell has to draw anyway.
  qt_has_wayland_plugin() {
    for dir in /usr/lib/*/qt[0-9]*/plugins/platforms; do
      for plugin in "${dir}"/libqwayland*.so; do
        [ -e "${plugin}" ] && return 0
      done
    done
    return 1
  }
  if command -v startlxqtwayland >/dev/null 2>&1 && qt_has_wayland_plugin; then
    export XDG_SESSION_TYPE=wayland
    export XDG_CURRENT_DESKTOP="LXQt:${SELKIES_WAYLAND_COMPOSITOR:-sway}:wlroots"
    export QT_QPA_PLATFORMTHEME=lxqt
    export XDG_MENU_PREFIX=lxqt-
    echo "[lxqt] session draws on ${WAYLAND_DISPLAY} natively"
  else
    # The session really is an X11 one from here on, so it has to say so: left naming
    # Wayland, Qt looks for a platform plugin this distribution does not ship and every
    # component starts by failing to load it, and anything else keying off the session
    # type reasons about a protocol its own windows are not on. WAYLAND_DISPLAY stays
    # exported so an application that speaks Wayland can still choose it.
    export XDG_SESSION_TYPE=x11
    echo "[lxqt] session draws through the compositor's XWayland on ${DISPLAY}"

    # sway manages the session's shell windows as ordinary floating ones; the
    # keeper anchors the panel to its edge and keeps the desktop tiled below it.
    # A restarted service would otherwise leave the previous keeper running.
    if [ "${SELKIES_WAYLAND_COMPOSITOR}" = "sway" ] && command -v swaymsg >/dev/null 2>&1; then
      pkill -f '/etc/service/lxqt/anchor.sh' 2>/dev/null
      bash /etc/service/lxqt/anchor.sh &
    fi
  fi
else
  export DISPLAY="${DISPLAY:-:20}"
  until [ -S "/tmp/.X11-unix/X${DISPLAY#*:}" ]; do sleep 0.5; done
  # The multi-monitor layout code drives Openbox, so the session runs it
  session_wm=openbox
fi
# LXQt keeps its stock configuration — the panel's plugin list, the session and
# window-manager defaults — under /usr/share/lxqt, which is a data directory rather
# than a config one: only the startlxqt wrapper puts it on the config path, and this
# service runs lxqt-session directly. Left off, the panel finds no plugin list and
# comes up as an empty bar with no menu, no task list and no clock.
if [ -z "${XDG_CONFIG_DIRS}" ]; then
  XDG_CONFIG_DIRS="/etc:/etc/xdg:/usr/share"
else
  for dir in /etc /etc/xdg /usr/share; do
    case ":${XDG_CONFIG_DIRS}:" in
      *":${dir}:"*) ;;
      *) XDG_CONFIG_DIRS="${XDG_CONFIG_DIRS}:${dir}" ;;
    esac
  done
fi
export XDG_CONFIG_DIRS

# Both of these are derived from the system defaults on every start, so the
# session is the same on a fresh container and a reused home directory. The
# pcmanfm-qt one has to go for the desktop to be drawn at all: it rewrites its
# whole settings file on exit, including the black background it defaults to
# when nothing else is configured, and that user file then shadows
# /etc/xdg/pcmanfm-qt for good.
rm -rf "${HOME}/.config/lxqt" "${HOME}/.config/pcmanfm-qt"
# Name the window manager in the session's own settings, which is the only place
# lxqt-session takes it from. The packaged default names one this session does not
# run, and an unresolvable name makes it ask interactively which of the installed
# managers to use — a question nobody answers in a container, leaving the session
# with no window manager and nothing painting the root. Written under HOME so it
# outranks the packaged file for this session alone.
mkdir -p "${HOME}/.config/lxqt"
printf '[General]\nwindow_manager=%s\n' "${session_wm}" > "${HOME}/.config/lxqt/session.conf"
# The panel, desktop, runner and PolicyKit agent are autostart entries carrying
# OnlyShowIn=LXQt, and a session started outside a display manager has nobody
# else to name the desktop
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-LXQt}"
exec dbus-launch --exit-with-session lxqt-session
