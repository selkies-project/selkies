#!/bin/bash
# This Source Code Form is subject to the terms of the Mozilla Public
# License, v. 2.0. If a copy of the MPL was not distributed with this
# file, You can obtain one at https://mozilla.org/MPL/2.0/.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/runtime-ubuntu}"
until [ -f "${XDG_RUNTIME_DIR}/container-env" ]; do sleep 0.5; done
# shellcheck disable=SC1091  # written by container-entrypoint.sh at startup
. "${XDG_RUNTIME_DIR}/container-env"
shopt -s nullglob

# Session compositor for the Wayland backend, nested inside the capture
# compositor Selkies owns. It supplies what the capture compositor deliberately
# does not: window management, and an XWayland server so X11-only applications
# keep working. Applications connect to its socket, which Selkies auto-detects
# and retargets input and clipboard to (--app-wayland-display).

# Selkies is the only other compositor here, so the socket that exists before
# this one starts is the capture socket. The name is recorded rather than
# derived: Smithay numbers from wayland-1 and wlroots from wayland-0, so the
# nested socket sorts FIRST and picking by order would invert the two. Each
# socket sits beside a wayland-N.lock of the same stem, so only sockets count.
# A restart is the exception: this compositor may have left its own socket
# behind, so the name recorded earlier wins while it still answers.
unset WAYLAND_DISPLAY
recorded="$(cat "${XDG_RUNTIME_DIR}/selkies-capture-display" 2>/dev/null)"
[ -n "${recorded}" ] && [ -S "${XDG_RUNTIME_DIR}/${recorded}" ] && WAYLAND_DISPLAY="${recorded}"
until [ -n "${WAYLAND_DISPLAY}" ]; do
  sleep 0.5
  for socket in "${XDG_RUNTIME_DIR}"/wayland-[0-9]*; do
    [ -S "${socket}" ] && WAYLAND_DISPLAY="${socket##*/}" && break
  done
done
export WAYLAND_DISPLAY
echo "${WAYLAND_DISPLAY}" > "${XDG_RUNTIME_DIR}/selkies-capture-display"

export WLR_BACKENDS=wayland
# The nested backend takes its screen count at startup and none of these compositors
# can add one later, so the room for the second display Selkies supports is made here.
# Selkies holds the spare clear of every capture output and moves it onto the second
# output the moment that output exists.
export WLR_WL_OUTPUTS="${SELKIES_WAYLAND_OUTPUTS:-2}"

# A spare screen is free to capture but not to the desktop: the session compositor lays
# it out beside the first, so XWayland's screen — and with it the desktop, its icons and
# every "centre of the screen" — spans twice the area anything shows. sway can hold an
# output out of the layout and put it back, so the spare is parked until the capture
# compositor really drives two outputs. labwc accepts the same request and then refuses
# to re-enable, which would cost the second display for the life of the session, so it
# keeps both outputs and the wider desktop instead.
# $1 is the capture compositor's socket, which is what the output count is read from;
# this shell's own WAYLAND_DISPLAY is about to belong to sway's clients instead. sway
# names its IPC socket after its pid, and it inherits this script's through the exec
# below, so the name is known before it exists.
park_spare_output() {
  command -v swaymsg >/dev/null 2>&1 || return 0
  local capture_display="$1" spare="" state="" wanted outputs
  export SWAYSOCK="${XDG_RUNTIME_DIR}/sway-ipc.$(id -u).$$.sock"
  # The last output is the spare: Selkies drives the first and adds the second only
  # when a client arrives for it.
  until [ -n "${spare}" ]; do
    sleep 2
    spare="$(swaymsg -t get_outputs -r 2>/dev/null |
             sed -n 's/.*"name": "\(WL-[0-9]*\)".*/\1/p' | sort | tail -1)"
  done
  while :; do
    outputs="$(WAYLAND_DISPLAY="${capture_display}" wayland-info 2>/dev/null |
               grep -c "interface: 'wl_output'")"
    if [ "${outputs:-1}" -ge 2 ] 2>/dev/null; then wanted=enable; else wanted=disable; fi
    if [ "${wanted}" != "${state}" ] && swaymsg output "${spare}" "${wanted}" >/dev/null 2>&1; then
      echo "[wayland] spare output ${spare} ${wanted}d (capture drives ${outputs:-1})"
      state="${wanted}"
    fi
    sleep 3
  done
}

if [ "${SELKIES_WAYLAND_COMPOSITOR}" = "sway" ] && [ "${WLR_WL_OUTPUTS}" -gt 1 ] 2>/dev/null; then
  park_spare_output "${WAYLAND_DISPLAY}" &
fi
[ -n "${SELKIES_WAYLAND_RENDERER}" ] && export WLR_RENDERER="${SELKIES_WAYLAND_RENDERER}"

# sway refuses to start when it sees the proprietary NVIDIA driver, which does not
# apply here: WLR_BACKENDS=wayland makes it a client of the capture compositor, so
# it never drives the GPU. The flag only suppresses that refusal, so it is passed
# unconditionally rather than probed for.
[ "${SELKIES_WAYLAND_COMPOSITOR}" = "sway" ] && exec sway --unsupported-gpu
exec "${SELKIES_WAYLAND_COMPOSITOR}"
