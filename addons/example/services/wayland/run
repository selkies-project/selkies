#!/bin/bash
# This Source Code Form is subject to the terms of the Mozilla Public
# License, v. 2.0. If a copy of the MPL was not distributed with this
# file, You can obtain one at https://mozilla.org/MPL/2.0/.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/runtime-ubuntu}"
until [ -f "${XDG_RUNTIME_DIR}/container-env" ]; do sleep 0.5; done
# shellcheck disable=SC1091  # written by container-entrypoint.sh at startup
. "${XDG_RUNTIME_DIR}/container-env"
shopt -s nullglob

# Session compositor for the Wayland backend, nested inside the capture
# compositor Selkies owns. It supplies what the capture compositor deliberately
# does not: window management, and an XWayland server so X11-only applications
# keep working. Applications connect to its socket, which Selkies auto-detects
# and retargets input and clipboard to (--app-wayland-display).

# Selkies is the only other compositor here, so the socket that exists before
# this one starts is the capture socket. The name is recorded rather than
# derived: Smithay numbers from wayland-1 and wlroots from wayland-0, so the
# nested socket sorts FIRST and picking by order would invert the two. Each
# socket sits beside a wayland-N.lock of the same stem, so only sockets count.
# A restart is the exception: this compositor may have left its own socket
# behind, so the name recorded earlier wins while it still answers.
unset WAYLAND_DISPLAY
recorded="$(cat "${XDG_RUNTIME_DIR}/selkies-capture-display" 2>/dev/null)"
[ -n "${recorded}" ] && [ -S "${XDG_RUNTIME_DIR}/${recorded}" ] && WAYLAND_DISPLAY="${recorded}"
until [ -n "${WAYLAND_DISPLAY}" ]; do
  sleep 0.5
  for socket in "${XDG_RUNTIME_DIR}"/wayland-[0-9]*; do
    [ -S "${socket}" ] && WAYLAND_DISPLAY="${socket##*/}" && break
  done
done
export WAYLAND_DISPLAY
echo "${WAYLAND_DISPLAY}" > "${XDG_RUNTIME_DIR}/selkies-capture-display"

export WLR_BACKENDS=wayland
# A screen the session holds before a client asks for it is one it lays out anyway:
# XWayland's root — and with it the desktop, its icons and every "centre of the
# screen" — spans twice the area anything shows. So screens are made on demand below.
# WLR_WL_OUTPUTS is read once at startup and honoured only up to wlroots 0.18, and is
# set only for a session that asks for a fixed count.
[ -n "${SELKIES_WAYLAND_OUTPUTS}" ] && export WLR_WL_OUTPUTS="${SELKIES_WAYLAND_OUTPUTS}"

# Keeps the session's screen count equal to the number of outputs Selkies captures, so
# a second display appears when its client connects and leaves with it. A screen is only
# added where it can also be taken away: `unplug` needs sway 1.9 or newer, and older sway
# accepts `disable` and a position off the layout without acting on either, so a screen
# added there would widen the desktop for the life of the session. Those sessions stay
# at one screen unless SELKIES_WAYLAND_OUTPUTS asked for more up front.
# $1 is the capture compositor's socket, which is what the count is read from; this
# shell's own WAYLAND_DISPLAY is about to belong to sway's clients instead. sway names
# its IPC socket after its pid, and it inherits this script's through the exec below,
# so the name is known before it exists.
track_capture_outputs() {
  command -v swaymsg >/dev/null 2>&1 || return 0
  local capture_display="$1" want have last
  export SWAYSOCK="${XDG_RUNTIME_DIR}/sway-ipc.$(id -u).$$.sock"
  until swaymsg -t get_outputs >/dev/null 2>&1; do sleep 1; done
  # `unplug` needs sway 1.9. Below it a screen cannot be taken away at all — the
  # verb does not parse, and `disable` and a position off the layout are both
  # accepted without being acted on — so one added there would widen the desktop
  # for the life of the session.
  case "$(sway --version 2>/dev/null)" in
    *"version 1."[0-8] | *"version 1."[0-8].*)
      echo "[wayland] this sway cannot remove a screen it added; staying at one"
      return 0
      ;;
  esac
  while :; do
    want="$(WAYLAND_DISPLAY="${capture_display}" wayland-info 2>/dev/null |
            grep -c "interface: 'wl_output'")"
    [ "${want:-0}" -ge 1 ] 2>/dev/null || want=1
    have="$(swaymsg -t get_outputs 2>/dev/null | grep -c '"name": "WL-')"
    while [ "${have:-0}" -lt "${want}" ]; do
      swaymsg create_output >/dev/null 2>&1 || break
      echo "[wayland] added a screen (capture drives ${want})"
      have=$((have + 1))
    done
    while [ "${have:-0}" -gt "${want}" ]; do
      last="$(swaymsg -t get_outputs 2>/dev/null |
              sed -n 's/.*"name": "\(WL-[0-9]*\)".*/\1/p' | sort -V | tail -1)"
      [ -n "${last}" ] && swaymsg output "${last}" unplug >/dev/null 2>&1 || break
      echo "[wayland] removed screen ${last} (capture drives ${want})"
      have=$((have - 1))
    done
    sleep 3
  done
}

if [ "${SELKIES_WAYLAND_COMPOSITOR}" = "sway" ]; then
  track_capture_outputs "${WAYLAND_DISPLAY}" &
fi
[ -n "${SELKIES_WAYLAND_RENDERER}" ] && export WLR_RENDERER="${SELKIES_WAYLAND_RENDERER}"

# sway refuses to start when it sees the proprietary NVIDIA driver, which does not
# apply here: WLR_BACKENDS=wayland makes it a client of the capture compositor, so
# it never drives the GPU. The flag only suppresses that refusal, so it is passed
# unconditionally rather than probed for.
[ "${SELKIES_WAYLAND_COMPOSITOR}" = "sway" ] && exec sway --unsupported-gpu
exec "${SELKIES_WAYLAND_COMPOSITOR}"
