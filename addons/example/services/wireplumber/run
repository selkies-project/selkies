#!/bin/bash
# This Source Code Form is subject to the terms of the Mozilla Public
# License, v. 2.0. If a copy of the MPL was not distributed with this
# file, You can obtain one at https://mozilla.org/MPL/2.0/.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/runtime-ubuntu}"
export DISABLE_RTKIT="y"
export PIPEWIRE_LATENCY="256/48000"
# The session manager must not start until PipeWire is actually answering: a
# lock file appears before the daemon serves, and a wireplumber that connects to
# a half-started daemon exits immediately and is respawned in a loop.
until [ -S "${XDG_RUNTIME_DIR}/pipewire-0" ]; do sleep 0.5; done
if command -v pw-cli >/dev/null 2>&1; then
    until pw-cli info 0 >/dev/null 2>&1; do sleep 0.5; done
fi
exec dbus-run-session -- /usr/bin/wireplumber
