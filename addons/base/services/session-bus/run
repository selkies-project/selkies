#!/bin/bash
# This Source Code Form is subject to the terms of the Mozilla Public
# License, v. 2.0. If a copy of the MPL was not distributed with this
# file, You can obtain one at https://mozilla.org/MPL/2.0/.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/runtime-ubuntu}"
until [ -f "${XDG_RUNTIME_DIR}/container-env" ]; do sleep 0.5; done
# shellcheck disable=SC1091  # written by container-entrypoint.sh at startup
. "${XDG_RUNTIME_DIR}/container-env"
shopt -s nullglob

# The session bus at ${XDG_RUNTIME_DIR}/bus, the address GLib and libdbus
# connect to when a process names no bus of its own: an application started
# outside a desktop session (a browser an image runs alone, a command launched
# where no desktop runs a bus to adopt) reaches dconf and the settings portal
# here, and with them the color scheme Selkies hands the desktop. The portal's
# GTK backend is started on demand by this bus and has to open the display its
# applications use, so the bus starts once that display is up and with it in its
# environment: activated without one, the portal comes up without its settings
# and keeps them from every application until it restarts.
bus="${XDG_RUNTIME_DIR}/bus"
if [ -S "${bus}" ]; then
  if dbus-send --bus="unix:path=${bus}" --dest=org.freedesktop.DBus --type=method_call \
      --print-reply / org.freedesktop.DBus.GetId >/dev/null 2>&1; then
    echo "[session-bus] ${bus} is already served; leaving it to its owner"
    exec sleep infinity
  fi
  # Left behind by a bus that is gone, which would keep this one from binding
  rm -f "${bus}"
fi

if [ "${SELKIES_WAYLAND:-false}" = "true" ]; then
  if [ -n "${SELKIES_WAYLAND_HOST_DISPLAY-}" ]; then
    echo "[session-bus] the operator's compositor runs a session of its own"
    exec sleep infinity
  fi
  unset DISPLAY WAYLAND_DISPLAY
  if [ "${SELKIES_WAYLAND_COMPOSITOR:-none}" = "none" ]; then
    # Applications are clients of the capture compositor, the only one here
    until [ -n "${WAYLAND_DISPLAY}" ]; do
      sleep 0.5
      for socket in "${XDG_RUNTIME_DIR}"/wayland-[0-9]*; do
        [ -S "${socket}" ] && WAYLAND_DISPLAY="${socket##*/}" && break
      done
    done
  else
    # Applications are clients of the nested compositor: the socket the
    # wayland service did not record as the capture compositor's
    until [ -f "${XDG_RUNTIME_DIR}/selkies-capture-display" ]; do sleep 0.5; done
    capture="$(cat "${XDG_RUNTIME_DIR}/selkies-capture-display")"
    until [ -n "${WAYLAND_DISPLAY}" ]; do
      sleep 0.5
      for socket in "${XDG_RUNTIME_DIR}"/wayland-[0-9]*; do
        [ -S "${socket}" ] && [ "${socket##*/}" != "${capture}" ] \
          && WAYLAND_DISPLAY="${socket##*/}" && break
      done
    done
  fi
  export WAYLAND_DISPLAY
else
  export DISPLAY="${DISPLAY:-:20}"
  until [ -S "/tmp/.X11-unix/X${DISPLAY#*:}" ]; do sleep 0.5; done
fi

echo "[session-bus] serving ${bus} for ${WAYLAND_DISPLAY:-${DISPLAY}}"
exec dbus-daemon --session --nofork --nopidfile --nosyslog --address="unix:path=${bus}"
