#
# Download a file and check it against the hash its source publishes for it.
#
# The version a build takes can float (the newest release, a branch's head)
# while what arrives is still checked: against the SHA-256 GitHub records for a
# release asset, the blob hash GitHub's API names for a file at a commit, or the
# fingerprint of an OpenPGP key. Nothing is written until it has been checked;
# a file that does not match is removed and the command fails.
#
#     fetch-verified release OWNER/REPO TAG ASSET OUT
#         The release asset ASSET of TAG ("latest" for the newest release), its
#         "{tag}" and "{version}" (the tag without a leading v) filled in,
#         checked against the asset's digest. Prints the tag.
#     fetch-verified file OWNER/REPO REF PATH OUT [PATH OUT ...]
#         Each PATH at REF (a branch, tag or commit, resolved to one commit for
#         every path), checked against the blob hash the API names for it.
#         Prints the commit.
#     fetch-verified key URL FINGERPRINT[,FINGERPRINT...] OUT
#         An OpenPGP public key file, armored or not, whose every primary key
#         has to be one of the fingerprints listed.
#
# A token in /run/secrets/github_token, GITHUB_TOKEN or GH_TOKEN is sent to
# GitHub's API where present, whose anonymous rate is 60 requests an hour; it
# goes to curl in a configuration file, never on a command line.
#
# Needs curl, jq and the coreutils (sha1sum, sha256sum, base64, od, dd).
set -eu

API="https://api.github.com"
TRIES=5

usage() {
    sed -n '/^#     fetch-verified/,/^#$/s/^# \{0,1\}//p' "$0" >&2
    exit 1
}

die() {
    printf 'fetch-verified: %s\n' "$*" >&2
    exit 1
}

# The check failed: OUT goes, whatever was there before.
fail() {
    rm -f "$1"
    shift
    die "$@"
}

for tool in curl jq sha1sum sha256sum base64 od dd mktemp; do
    command -v "${tool}" > /dev/null 2>&1 || die "needs ${tool}"
done

WORK="$(mktemp -d)"
trap 'rm -rf "${WORK}"' EXIT
trap 'exit 1' HUP INT TERM

# curl's configuration: the agent for every request, and for the API its media
# type and the token where one is given. The directory is mktemp's, readable by
# this user alone.
printf 'user-agent = "fetch-verified"\n' > "${WORK}/plain.conf"
{
    printf 'user-agent = "fetch-verified"\n'
    printf 'header = "Accept: application/vnd.github+json"\n'
    TOKEN=""
    if [ -r /run/secrets/github_token ]; then
        TOKEN="$(tr -d ' \t\r\n' < /run/secrets/github_token)"
    fi
    TOKEN="${TOKEN:-${GITHUB_TOKEN:-${GH_TOKEN:-}}}"
    case "${TOKEN}" in
        "") ;;
        *[!A-Za-z0-9_.-]*) die "the GitHub token holds characters no token has" ;;
        *) printf 'header = "Authorization: Bearer %s"\n' "${TOKEN}" ;;
    esac
    unset TOKEN
} > "${WORK}/api.conf"

# get URL FILE [api]: the body of URL in FILE, through redirects. A server
# error, a 403 or 429 (GitHub's secondary rate limit, which may name its delay
# in Retry-After) and a failed connection are tried again after a widening wait
# where none is named, long enough in all (five minutes) to outlast a GitHub
# outage of minutes; any other status fails at once.
get() {
    get_url="$1"
    get_out="$2"
    get_conf="${WORK}/plain.conf"
    [ "${3:-}" = api ] && get_conf="${WORK}/api.conf"
    get_attempt=1
    while :; do
        get_rc=0
        get_code="$(curl -sS -L --max-time 120 -K "${get_conf}" -D "${WORK}/headers" \
            -o "${get_out}" -w '%{http_code}' "${get_url}" 2> "${WORK}/error")" || get_rc=$?
        if [ "${get_rc}" -eq 0 ]; then
            case "${get_code}" in
                2[0-9][0-9]) return 0 ;;
            esac
            case "${get_code}" in
                5[0-9][0-9] | 403 | 429) ;;
                *) die "${get_url}: HTTP ${get_code}" ;;
            esac
            [ "${get_attempt}" -lt "${TRIES}" ] || die "${get_url}: HTTP ${get_code}"
            # The last response's Retry-After: a proxy's CONNECT and each
            # redirect write a header block of their own before it.
            get_wait="$(awk 'BEGIN { IGNORECASE = 1 }
                /^HTTP\// { wait = "" }
                tolower($0) ~ /^retry-after:/ { sub(/^[^:]*:[ \t]*/, ""); sub(/[ \t\r]+$/, ""); wait = $0 }
                END { print wait }' "${WORK}/headers")"
            case "${get_wait}" in
                "" | *[!0-9]*)
                    case "${get_code}" in
                        403 | 429) get_delay=$((15 * get_attempt)) ;;
                        *) get_delay=$((30 * get_attempt)) ;;
                    esac
                    ;;
                *) get_delay="${get_wait}" ;;
            esac
            printf 'fetch-verified: %s: HTTP %s, waiting %ss\n' "${get_url}" "${get_code}" "${get_delay}" >&2
            sleep "${get_delay}"
        else
            get_error="$(tr '\n' ' ' < "${WORK}/error")"
            [ "${get_attempt}" -lt "${TRIES}" ] || die "${get_url}: ${get_error:-curl failed with ${get_rc}}"
            printf 'fetch-verified: %s: %s, waiting %ss\n' "${get_url}" "${get_error:-curl failed with ${get_rc}}" "$((30 * get_attempt))" >&2
            sleep $((30 * get_attempt))
        fi
        get_attempt=$((get_attempt + 1))
    done
}

# The hex digest TOOL prints for FILE, which has to be LENGTH hex digits.
digest() {
    digest_hex="$("$1" < "$2")" || die "$1 failed"
    digest_hex="${digest_hex%% *}"
    case "${digest_hex}" in
        *[!0-9a-f]* | "") die "$1 printed no digest" ;;
    esac
    [ "${#digest_hex}" -eq "$3" ] || die "$1 printed no digest"
    printf '%s' "${digest_hex}"
}

# Write FILE's checked bytes to OUT, its directory made where missing.
put() {
    mkdir -p "$(dirname "$2")"
    cat "$1" > "$2"
}

release() {
    repo="$1" tag="$2" asset="$3" out="$4"
    case "${tag}" in
        latest) path="latest" ;;
        *) path="tags/${tag}" ;;
    esac
    get "${API}/repos/${repo}/releases/${path}" "${WORK}/release.json" api
    name="$(jq -er '.tag_name | strings' "${WORK}/release.json")" \
        || die "${repo}: the release ${tag} names no tag"
    file="$(jq -er --arg asset "${asset}" \
        '.tag_name as $tag | $asset | gsub("\\{tag\\}"; $tag) | gsub("\\{version\\}"; $tag | ltrimstr("v"))' \
        "${WORK}/release.json")" || die "${repo} ${name}: cannot fill in ${asset}"
    jq -e --arg file "${file}" '[.assets[]? | select(.name == $file)] | length > 0' \
        "${WORK}/release.json" > /dev/null || die "${repo} ${name} has no asset ${file}"
    recorded="$(jq -r --arg file "${file}" \
        '[.assets[]? | select(.name == $file)][0].digest // "" | strings' "${WORK}/release.json")" || recorded=""
    case "${recorded}" in
        sha256:*) ;;
        *) die "${repo} ${name} records no SHA-256 for ${file}" ;;
    esac
    url="$(jq -er --arg file "${file}" \
        '[.assets[]? | select(.name == $file)][0].browser_download_url | strings' "${WORK}/release.json")" \
        || die "${repo} ${name} gives no download address for ${file}"
    get "${url}" "${WORK}/asset"
    actual="$(digest sha256sum "${WORK}/asset" 64)"
    [ "${actual}" = "${recorded#sha256:}" ] \
        || fail "${out}" "${file} of ${repo} ${name} hashes to ${actual}, not the recorded ${recorded}"
    put "${WORK}/asset" "${out}"
    printf '%s\n' "${name}"
}

files() {
    repo="$1" ref="$2"
    shift 2
    get "${API}/repos/${repo}/commits/${ref}" "${WORK}/commit.json" api
    commit="$(jq -er '.sha | strings' "${WORK}/commit.json")" || die "${repo}: ${ref} names no commit"
    case "${commit}" in
        *[!0-9a-f]* | "") die "${repo}: ${ref} names no commit" ;;
    esac
    while [ "$#" -gt 0 ]; do
        path="$1" out="$2"
        shift 2
        get "${API}/repos/${repo}/contents/${path}?ref=${commit}" "${WORK}/contents.json" api
        blob="$(jq -er '.sha | strings' "${WORK}/contents.json")" \
            || die "${repo}: ${path} at ${commit} has no blob hash"
        get "https://raw.githubusercontent.com/${repo}/${commit}/${path}" "${WORK}/file"
        size="$(wc -c < "${WORK}/file")"
        {
            printf 'blob %d\000' "$((size))"
            cat "${WORK}/file"
        } > "${WORK}/object"
        actual="$(digest sha1sum "${WORK}/object" 40)"
        [ "${actual}" = "${blob}" ] \
            || fail "${out}" "${path} of ${repo} at ${commit} hashes to blob ${actual}, not the ${blob} the API names"
        put "${WORK}/file" "${out}"
    done
    printf '%s\n' "${commit}"
}

# The bytes of FILE from OFFSET, COUNT of them, on stdout.
bytes() {
    dd if="$1" bs=1 skip="$2" count="$3" 2> /dev/null
}

# A big-endian number, WIDTH bytes wide, as the octal escapes printf's %b takes.
be() {
    be_n="$1" be_out=""
    be_i=0
    while [ "${be_i}" -lt "$2" ]; do
        be_out="$(printf '\\0%03o' $((be_n % 256)))${be_out}"
        be_n=$((be_n / 256))
        be_i=$((be_i + 1))
    done
    printf '%s' "${be_out}"
}

# The fingerprints of every primary key in the OpenPGP key file FILE, one a
# line, upper case. Fails on anything it cannot read as key packets.
fingerprints() {
    keys="${WORK}/key.bin"
    if grep -a -q -- '-----BEGIN PGP' "$1"; then
        # The armor's base64 between its header lines' blank line and the
        # checksum line (=XXXX).
        awk '
            !started { if ($0 ~ /^-----BEGIN PGP/) { started = 1; headers = 1 } next }
            /^-----END PGP/ { exit }
            headers { if ($0 !~ /[^ \t\r]/) headers = 0; next }
            /^=/ { next }
            { gsub(/[ \t\r]/, ""); printf "%s", $0 }
        ' "$1" > "${WORK}/key.b64"
        base64 -d < "${WORK}/key.b64" > "${keys}" 2> /dev/null || return 1
    else
        cp "$1" "${keys}"
    fi
    # Each primary key packet (tag 6) as "VERSION OFFSET LENGTH", its body's
    # place in the file; "error" for what is not a whole packet.
    od -An -v -tu1 "${keys}" | awk '
        { for (f = 1; f <= NF; f++) b[n++] = $f }
        END {
            i = 0
            while (i < n) {
                head = b[i]
                if (head < 128) { print "error"; exit }
                if (head >= 192) {
                    tag = head - 192; i++
                    if (i >= n) { print "error"; exit }
                    first = b[i]
                    if (first < 192) { length_ = first; i++ }
                    else if (first < 224) {
                        if (i + 1 >= n) { print "error"; exit }
                        length_ = (first - 192) * 256 + b[i + 1] + 192; i += 2
                    } else if (first == 255) {
                        if (i + 4 >= n) { print "error"; exit }
                        length_ = ((b[i + 1] * 256 + b[i + 2]) * 256 + b[i + 3]) * 256 + b[i + 4]; i += 5
                    } else { print "error"; exit }
                } else {
                    tag = int((head - 128) / 4); kind = head % 4; i++
                    if (kind == 3) { print "error"; exit }
                    size = kind == 0 ? 1 : (kind == 1 ? 2 : 4)
                    if (i + size > n) { print "error"; exit }
                    length_ = 0
                    for (k = 0; k < size; k++) length_ = length_ * 256 + b[i + k]
                    i += size
                }
                if (length_ < 1 || i + length_ > n) { print "error"; exit }
                if (tag == 6) print b[i], i, length_
                i += length_
            }
        }
    ' > "${WORK}/packets"
    [ -s "${WORK}/packets" ] || return 1
    ! grep -qx error "${WORK}/packets" || return 1
    while read -r version offset length; do
        case "${version}" in
            4)
                {
                    printf '%b' "\\0231$(be "${length}" 2)"
                    bytes "${keys}" "${offset}" "${length}"
                } > "${WORK}/packet"
                printf '%s\n' "$(digest sha1sum "${WORK}/packet" 40)"
                ;;
            6)
                {
                    printf '%b' "\\0233$(be "${length}" 4)"
                    bytes "${keys}" "${offset}" "${length}"
                } > "${WORK}/packet"
                printf '%s\n' "$(digest sha256sum "${WORK}/packet" 64)"
                ;;
            *) return 1 ;;
        esac
    done < "${WORK}/packets" | tr 'a-f' 'A-F'
}

key() {
    url="$1" expected="$2" out="$3"
    get "${url}" "${WORK}/key"
    allowed="$(printf '%s' "${expected}" | tr -d ' ' | tr ',' '\n' | tr 'a-f' 'A-F' | grep . | sort -u)" || allowed=""
    fingerprints "${WORK}/key" > "${WORK}/found" || fail "${out}" "${url} is no readable OpenPGP key"
    # A version neither 4 nor 6 ends the loop above early, in a subshell:
    # every primary key has to have been fingerprinted.
    [ "$(wc -l < "${WORK}/found")" -eq "$(wc -l < "${WORK}/packets")" ] \
        || fail "${out}" "${url} is no readable OpenPGP key: a key of a version other than 4 or 6"
    found="$(cat "${WORK}/found")"
    shown_found="$(printf '%s' "${found}" | tr '\n' ',' | sed 's/,$//; s/,/, /g')"
    shown_allowed="$(printf '%s' "${allowed}" | tr '\n' ',' | sed 's/,$//; s/,/, /g')"
    [ -n "${found}" ] || fail "${out}" "${url} holds keys none, not only ${shown_allowed}"
    for fingerprint in ${found}; do
        printf '%s\n' "${allowed}" | grep -qxF "${fingerprint}" \
            || fail "${out}" "${url} holds keys ${shown_found}, not only ${shown_allowed}"
    done
    put "${WORK}/key" "${out}"
}

case "${1:-}" in
    release) [ "$#" -eq 5 ] || usage; shift; release "$@" ;;
    file) [ "$#" -ge 5 ] && [ $(($# % 2)) -eq 1 ] || usage; shift; files "$@" ;;
    key) [ "$#" -eq 4 ] || usage; shift; key "$@" ;;
    *) usage ;;
esac
