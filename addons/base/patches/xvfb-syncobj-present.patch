diff --git a/glamor/glamor_egl.c b/glamor/glamor_egl.c
index 79331ca..082e794 100644
--- a/glamor/glamor_egl.c
+++ b/glamor/glamor_egl.c
@@ -1593,6 +1593,196 @@ glamor_dri3_open_client(ClientPtr client,
     return Success;
 }
 
+/*
+ * DRI3 1.4 timeline syncobjs on the render node glamor draws with, for
+ * clients that synchronize explicitly: a present waits for the client's
+ * acquire point and hands back a release point the copy's fence signals.
+ * The NVIDIA driver attaches no implicit fence to a dmabuf, so without
+ * these its presents race glamor's copy in both directions.
+ */
+struct glamor_dri3_syncobj {
+    struct dri3_syncobj base;
+    uint32_t handle;
+};
+
+static int
+glamor_syncobj_drm_fd(struct dri3_syncobj *syncobj)
+{
+    return glamor_egl_get_screen_private(syncobj->screen)->fd;
+}
+
+static Bool
+glamor_syncobj_check(struct dri3_syncobj *syncobj, uint64_t point, uint32_t flags)
+{
+    struct glamor_dri3_syncobj *gs = (struct glamor_dri3_syncobj *) syncobj;
+
+    return !drmSyncobjTimelineWait(glamor_syncobj_drm_fd(syncobj), &gs->handle,
+                                   &point, 1, 0, flags, NULL);
+}
+
+static Bool
+glamor_syncobj_has_fence(struct dri3_syncobj *syncobj, uint64_t point)
+{
+    return glamor_syncobj_check(syncobj, point, DRM_SYNCOBJ_WAIT_FLAGS_WAIT_AVAILABLE);
+}
+
+static Bool
+glamor_syncobj_is_signaled(struct dri3_syncobj *syncobj, uint64_t point)
+{
+    return glamor_syncobj_check(syncobj, point, DRM_SYNCOBJ_WAIT_FLAGS_WAIT_FOR_SUBMIT);
+}
+
+static int
+glamor_syncobj_export_fence(struct dri3_syncobj *syncobj, uint64_t point)
+{
+    struct glamor_dri3_syncobj *gs = (struct glamor_dri3_syncobj *) syncobj;
+    int drm_fd = glamor_syncobj_drm_fd(syncobj);
+    uint32_t temp;
+    int fd = -1;
+
+    if (drmSyncobjCreate(drm_fd, 0, &temp))
+        return -1;
+    if (!drmSyncobjTransfer(drm_fd, temp, 0, gs->handle, point, 0))
+        drmSyncobjExportSyncFile(drm_fd, temp, &fd);
+    drmSyncobjDestroy(drm_fd, temp);
+    return fd;
+}
+
+static void
+glamor_syncobj_signal(struct dri3_syncobj *syncobj, uint64_t point)
+{
+    struct glamor_dri3_syncobj *gs = (struct glamor_dri3_syncobj *) syncobj;
+
+    drmSyncobjTimelineSignal(glamor_syncobj_drm_fd(syncobj), &gs->handle, &point, 1);
+}
+
+static void
+glamor_syncobj_import_fence(struct dri3_syncobj *syncobj, uint64_t point, int fd)
+{
+    struct glamor_dri3_syncobj *gs = (struct glamor_dri3_syncobj *) syncobj;
+    int drm_fd = glamor_syncobj_drm_fd(syncobj);
+    Bool imported = FALSE;
+    uint32_t temp;
+
+    if (fd >= 0 && !drmSyncobjCreate(drm_fd, 0, &temp)) {
+        imported = !drmSyncobjImportSyncFile(drm_fd, temp, fd) &&
+                   !drmSyncobjTransfer(drm_fd, gs->handle, point, temp, 0, 0);
+        drmSyncobjDestroy(drm_fd, temp);
+    }
+    if (fd >= 0)
+        close(fd);
+    /* A release point nothing signals would leave the client waiting on its
+     * buffer forever; glamor_egl_flush_fenced() already waited for the copy. */
+    if (!imported)
+        glamor_syncobj_signal(syncobj, point);
+}
+
+static void
+glamor_syncobj_submitted_eventfd(struct dri3_syncobj *syncobj, uint64_t point, int efd)
+{
+    struct glamor_dri3_syncobj *gs = (struct glamor_dri3_syncobj *) syncobj;
+
+    drmSyncobjEventfd(glamor_syncobj_drm_fd(syncobj), gs->handle, point, efd,
+                      DRM_SYNCOBJ_WAIT_FLAGS_WAIT_AVAILABLE);
+}
+
+static void
+glamor_syncobj_signaled_eventfd(struct dri3_syncobj *syncobj, uint64_t point, int efd)
+{
+    struct glamor_dri3_syncobj *gs = (struct glamor_dri3_syncobj *) syncobj;
+
+    drmSyncobjEventfd(glamor_syncobj_drm_fd(syncobj), gs->handle, point, efd, 0);
+}
+
+static void
+glamor_syncobj_free(struct dri3_syncobj *syncobj)
+{
+    struct glamor_dri3_syncobj *gs = (struct glamor_dri3_syncobj *) syncobj;
+
+    drmSyncobjDestroy(glamor_syncobj_drm_fd(syncobj), gs->handle);
+    free(gs);
+}
+
+static struct dri3_syncobj *
+glamor_dri3_import_syncobj(ClientPtr client, ScreenPtr screen, XID id, int fd)
+{
+    struct glamor_dri3_syncobj *gs = calloc(1, sizeof(*gs));
+
+    if (!gs)
+        return NULL;
+    if (drmSyncobjFDToHandle(glamor_egl_get_screen_private(screen)->fd, fd, &gs->handle)) {
+        free(gs);
+        return NULL;
+    }
+    gs->base.id = id;
+    gs->base.screen = screen;
+    gs->base.refcount = 1;
+    gs->base.free = glamor_syncobj_free;
+    gs->base.has_fence = glamor_syncobj_has_fence;
+    gs->base.is_signaled = glamor_syncobj_is_signaled;
+    gs->base.export_fence = glamor_syncobj_export_fence;
+    gs->base.import_fence = glamor_syncobj_import_fence;
+    gs->base.signal = glamor_syncobj_signal;
+    gs->base.submitted_eventfd = glamor_syncobj_submitted_eventfd;
+    gs->base.signaled_eventfd = glamor_syncobj_signaled_eventfd;
+    return &gs->base;
+}
+
+/*
+ * Timeline syncobjs, the eventfd ioctl a present waits on them with (Linux
+ * 6.6; an invalid handle is what it refuses where it exists), and native
+ * fences for the copies glamor queues.
+ */
+static Bool
+glamor_egl_supports_syncobjs(glamor_egl_priv_t *glamor_egl)
+{
+    uint64_t cap = 0;
+
+    if (drmGetCap(glamor_egl->fd, DRM_CAP_SYNCOBJ_TIMELINE, &cap) || !cap)
+        return FALSE;
+    drmSyncobjEventfd(glamor_egl->fd, 0, 0, -1, 0);
+    if (errno != ENOENT)
+        return FALSE;
+    return epoxy_has_egl_extension(glamor_egl->display, "EGL_ANDROID_native_fence_sync");
+}
+
+Bool
+glamor_egl_syncobj_capable(ScreenPtr screen)
+{
+    return glamor_egl_get_screen_private(screen)->syncobj_capable;
+}
+
+int
+glamor_egl_flush_fenced(ScreenPtr screen)
+{
+    static const EGLint attribs[] = {
+        EGL_SYNC_NATIVE_FENCE_FD_ANDROID, EGL_NO_NATIVE_FENCE_FD_ANDROID, EGL_NONE
+    };
+    glamor_egl_priv_t *glamor_egl = glamor_egl_get_screen_private(screen);
+    EGLSyncKHR sync;
+    uint32_t signaled;
+    int fd = -1;
+
+    glamor_make_current(glamor_get_screen_private(screen));
+    sync = eglCreateSyncKHR(glamor_egl->display, EGL_SYNC_NATIVE_FENCE_ANDROID, attribs);
+    glFlush();
+    if (sync != EGL_NO_SYNC_KHR) {
+        fd = eglDupNativeFenceFDANDROID(glamor_egl->display, sync);
+        eglDestroySyncKHR(glamor_egl->display, sync);
+    }
+    if (fd >= 0)
+        return fd;
+
+    /* No fence to hand out: the work is waited for here and a signaled
+     * one stands in. */
+    glFinish();
+    if (!drmSyncobjCreate(glamor_egl->fd, DRM_SYNCOBJ_CREATE_SIGNALED, &signaled)) {
+        drmSyncobjExportSyncFile(glamor_egl->fd, signaled, &fd);
+        drmSyncobjDestroy(glamor_egl->fd, signaled);
+    }
+    return fd;
+}
+
