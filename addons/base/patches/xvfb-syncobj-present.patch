+/*
+ * A screen without a driver of its own has no CRTC to ask, so its windows'
+ * capabilities are the screen's.
+ */
+uint32_t
+present_screen_query_capabilities(ScreenPtr screen)
+{
+    present_screen_priv_ptr screen_priv = present_screen_priv(screen);
+
+    if (!screen_priv || screen_priv->info)
+        return 0;
+
+    return screen_priv->query_capabilities(screen_priv);
+}
