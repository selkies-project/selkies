 void
 present_fake_queue_init(void)
 {
     xorg_list_init(&fake_vblank_queue);
+    if (fake_vblank_fd < 0)
+        fake_vblank_fd = timerfd_create(CLOCK_MONOTONIC, TFD_NONBLOCK | TFD_CLOEXEC);
+    if (fake_vblank_fd < 0)
+        FatalError("present: no timer for the fake vblank: %s\n", strerror(errno));
