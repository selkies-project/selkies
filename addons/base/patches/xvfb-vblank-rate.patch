-    return 0;
+    xorg_list_for_each_entry(fake_vblank, &fake_vblank_queue, list) {
+        uint64_t ust = present_fake_ust(present_fake_priv(fake_vblank->screen),
+                                        fake_vblank->msc);
+        if (ust < next)
+            next = ust;
+    }
+    if (next != UINT64_MAX) {
+        its.it_value.tv_sec = next / 1000000;
+        its.it_value.tv_nsec = next % 1000000 * 1000;
+    }
+    timerfd_settime(fake_vblank_fd, TFD_TIMER_ABSTIME, &its, NULL);
+}
+
+static void
+present_fake_do_timer(int fd, int ready, void *data)
+{
+    struct xorg_list            due;
+    present_fake_vblank_ptr     fake_vblank, tmp;
+    uint64_t                    expirations;
+    uint64_t                    now = GetTimeInMicros();
+
+    if (read(fd, &expirations, sizeof(expirations)) < 0 && errno != EAGAIN)
+        ErrorF("present: fake vblank timer: %s\n", strerror(errno));
+    xorg_list_init(&due);
+    xorg_list_for_each_entry_safe(fake_vblank, tmp, &fake_vblank_queue, list) {
+        if (present_fake_ust(present_fake_priv(fake_vblank->screen),
+                             fake_vblank->msc) <= now) {
+            xorg_list_del(&fake_vblank->list);
+            xorg_list_append(&fake_vblank->list, &due);
+        }
+    }
+    xorg_list_for_each_entry_safe(fake_vblank, tmp, &due, list) {
+        xorg_list_del(&fake_vblank->list);
+        present_fake_notify(fake_vblank->screen, fake_vblank->event_id);
+        free(fake_vblank);
+    }
+    present_fake_arm();
+}
+
+/*
+ * A request touching the property wakes the timer at once, so the queue is
+ * retimed as the rate changes rather than at the next vblank a client asks
+ * for; the request has run by the time the server polls again.
+ */
+static void
+present_fake_property_filter(CallbackListPtr *pcbl, void *closure, void *calldata)
+{
+    static const struct itimerspec at_once = { .it_value = { 0, 1 } };
+    PropertyFilterParam        *p = calldata;
+
+    if (p->property == fake_fps_atom)
+        timerfd_settime(fake_vblank_fd, TFD_TIMER_ABSTIME, &at_once, NULL);
 }
 
