 static struct xorg_list fake_vblank_queue;
 
+/*
+ * One timer serves the whole queue, armed for its soonest vblank to the
+ * microsecond: the server's own timers count whole milliseconds, which puts
+ * any rate whose interval is not one on an uneven cadence.
+ */
+static int fake_vblank_fd = -1;
+
+/*
+ * A client raises a screen's rate while the server runs by setting this on
+ * its root window (CARDINAL, frames per second, 1 to 1000); the screen runs
+ * at the faster of that and the rate it started at.
+ */
+static Atom fake_fps_atom;
+
 typedef struct present_fake_vblank {
     struct xorg_list            list;
     uint64_t                    event_id;
-    OsTimerPtr                  timer;
+    uint64_t                    msc;
     ScreenPtr                   screen;
 } present_fake_vblank_rec, *present_fake_vblank_ptr;
 
+static uint64_t
+present_fake_msc(present_screen_priv_ptr screen_priv, uint64_t ust)
+{
+    return screen_priv->fake_msc_base +
+        (ust - screen_priv->fake_ust_base) / screen_priv->fake_interval;
+}
+
+static uint64_t
+present_fake_ust(present_screen_priv_ptr screen_priv, uint64_t msc)
+{
+    if (msc <= screen_priv->fake_msc_base)
+        return screen_priv->fake_ust_base;
+    return screen_priv->fake_ust_base +
+        (msc - screen_priv->fake_msc_base) * screen_priv->fake_interval;
+}
+
+/*
+ * The screen's private, its interval brought up to date with the root
+ * window property. A change restarts the count from the current MSC, so
+ * MSCs stay continuous across it.
+ */
+static present_screen_priv_ptr
+present_fake_priv(ScreenPtr screen)
+{
+    present_screen_priv_ptr     screen_priv = present_screen_priv(screen);
+    uint32_t                    interval = screen_priv->fake_start_interval;
+    PropertyPtr                 prop;
+
+    if (screen->root &&
+        dixLookupProperty(&prop, screen->root, fake_fps_atom, serverClient,
+                          DixReadAccess) == Success &&
+        prop->type == XA_CARDINAL && prop->format == 32 && prop->size == 1) {
+        uint32_t fps = *(uint32_t *) prop->data;
+
+        if (fps >= 1 && fps <= 1000 && 1000000 / fps < interval)
+            interval = 1000000 / fps;
+    }
+    if (interval != screen_priv->fake_interval) {
+        uint64_t now = GetTimeInMicros();
+
+        screen_priv->fake_msc_base = present_fake_msc(screen_priv, now);
+        screen_priv->fake_ust_base = now;
+        screen_priv->fake_interval = interval;
+    }
+    return screen_priv;
+}
