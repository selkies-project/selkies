 #ifdef GLAMOR
+/*
+ * Put the screen pixmap on the GPU: a texture backed glamor pixmap replaces
+ * the system memory one fbScreenInit() set up, the way Xephyr's does, so a
+ * DRI3 client's present into a window and all 2D rendering are GPU work and
+ * pixels reach the CPU only when a client asks for them (GetImage /
+ * XShmGetImage). No GBM buffer is involved, so this holds on every EGL vendor
+ * glamor itself came up on.
+ */
+static Bool
+vfbCreateScreenResources(ScreenPtr pScreen)
+{
+    vfbScreenInfoPtr pvfb = &vfbScreens[pScreen->myNum];
+    PixmapPtr old_pixmap, gpu_pixmap;
+
+    pScreen->CreateScreenResources = pvfb->createScreenResources;
+    if (!pScreen->CreateScreenResources(pScreen))
+        return FALSE;
+    pScreen->CreateScreenResources = vfbCreateScreenResources;
+
+    old_pixmap = pScreen->GetScreenPixmap(pScreen);
+
+    gpu_pixmap = pScreen->CreatePixmap(pScreen,
+                                       old_pixmap->drawable.width,
+                                       old_pixmap->drawable.height,
+                                       pScreen->rootDepth,
+                                       GLAMOR_CREATE_NO_LARGE);
+    if (!gpu_pixmap || !glamor_get_pixmap_texture(gpu_pixmap)) {
+        LogMessage(X_WARNING,
+                   "vfb: could not create a %dx%d GPU screen pixmap, "
+                   "keeping the system memory framebuffer\n",
+                   old_pixmap->drawable.width, old_pixmap->drawable.height);
+        if (gpu_pixmap)
+            dixDestroyPixmap(gpu_pixmap, 0);
+        return TRUE;
+    }
+
+    pScreen->SetScreenPixmap(gpu_pixmap);
+    dixDestroyPixmap(old_pixmap, 0);
+    pvfb->gpuScreen = TRUE;
+
+    LogMessage(X_INFO, "vfb: screen pixmap is on the GPU (%dx%d)\n",
+               gpu_pixmap->drawable.width, gpu_pixmap->drawable.height);
+    return TRUE;
+}
