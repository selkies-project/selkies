+/*
+ * Give the screen pixmap a new size, keeping the pixmap object itself: the
+ * software cursor's Damage record, Present's screen pixmap checks and every
+ * window's pixmap pointer refer to it, so only its backing store changes.
+ * Content that still fits is carried over and new area is black.
+ *
+ * On the GPU a pixmap of the new size is drawn and its FBO exchanged into
+ * the screen pixmap, the same in-place replacement the modesetting driver
+ * does on a framebuffer resize. In software the memory buffer is replaced;
+ * the initial -shmem / -fbdir buffer is left alone since nothing draws into
+ * it once the screen pixmap points elsewhere.
+ *
+ * The RandR size range is the GPU's limit, so the framebuffer follows the
+ * layout a client asks for, up or down, from whatever size the server
+ * started at.
+ */
+static Bool
+vfbResizeScreenPixmap(ScreenPtr pScreen, int width, int height)
+{
+    vfbScreenInfoPtr pvfb = &vfbScreens[pScreen->myNum];
+    PixmapPtr pixmap = pScreen->GetScreenPixmap(pScreen);
+    ChangeGCVal val;
+    xRectangle rect;
+    GCPtr gc;
+
+    if (pixmap->drawable.width == width && pixmap->drawable.height == height)
+        return TRUE;
+
+#ifdef GLAMOR
+    if (pvfb->gpuScreen) {
+        glamor_pixmap_private *priv = glamor_get_pixmap_private(pixmap);
+        PixmapPtr new_pixmap;
+        int pitch;
+
+        new_pixmap = pScreen->CreatePixmap(pScreen, width, height,
+                                           pScreen->rootDepth,
+                                           GLAMOR_CREATE_NO_LARGE);
+        /* Never fall off the GPU silently: a system memory screen would
+         * bring the per-frame readback back for every DRI3 client. */
+        if (!new_pixmap || !glamor_get_pixmap_texture(new_pixmap)) {
+            LogMessage(X_ERROR,
+                       "vfb: %dx%d screen pixmap does not fit on the GPU\n",
+                       width, height);
+            if (new_pixmap)
+                dixDestroyPixmap(new_pixmap, 0);
+            return FALSE;
+        }
+
+        gc = GetScratchGC(pScreen->rootDepth, pScreen);
+        if (!gc) {
+            dixDestroyPixmap(new_pixmap, 0);
+            return FALSE;
+        }
+        val.val = pScreen->blackPixel;
+        ChangeGC(serverClient, gc, GCForeground, &val);
+        ValidateGC(&new_pixmap->drawable, gc);
+        rect.x = 0;
+        rect.y = 0;
+        rect.width = width;
+        rect.height = height;
+        gc->ops->PolyFillRect(&new_pixmap->drawable, gc, 1, &rect);
+        gc->ops->CopyArea(&pixmap->drawable, &new_pixmap->drawable, gc,
+                          0, 0,
+                          min(width, pixmap->drawable.width),
+                          min(height, pixmap->drawable.height),
+                          0, 0);
+        FreeScratchGC(gc);
+
+        /* The screen pixmap takes the new FBO; the scratch pixmap takes the
+         * outgoing one and frees it with itself. */
+        glamor_pixmap_exchange_fbos(pixmap, new_pixmap);
+        pitch = (((width * pixmap->drawable.bitsPerPixel + 7) / 8) + 3) & ~3;
+        pScreen->ModifyPixmapHeader(pixmap, width, height, -1, -1, pitch, NULL);
+        /* What glamor records for a single-FBO pixmap at creation */
+        priv->box.x1 = 0;
+        priv->box.y1 = 0;
+        priv->box.x2 = width;
+        priv->box.y2 = height;
+        priv->block_w = width;
+        priv->block_h = height;
+        priv->block_wcnt = 1;
+        priv->block_hcnt = 1;
+        priv->box_array = &priv->box;
+        priv->fbo_array = &priv->fbo;
+        dixDestroyPixmap(new_pixmap, 0);
+        return TRUE;
+    }
+#endif
+
+    {
+        int old_width = pixmap->drawable.width;
+        int old_height = pixmap->drawable.height;
+        int old_stride = pixmap->devKind;
+        char *old_bits = pixmap->devPrivate.ptr;
+        int stride = PixmapBytePad(width, pScreen->rootDepth);
+        char *bits;
+        int y, row_bytes;
+
+        bits = calloc(height, stride);
+        if (!bits)
+            return FALSE;
+
+        pScreen->ModifyPixmapHeader(pixmap, width, height, -1, -1, stride, bits);
+
+        gc = GetScratchGC(pScreen->rootDepth, pScreen);
+        if (gc) {
+            val.val = pScreen->blackPixel;
+            ChangeGC(serverClient, gc, GCForeground, &val);
+            ValidateGC(&pixmap->drawable, gc);
+            rect.x = 0;
+            rect.y = 0;
+            rect.width = width;
+            rect.height = height;
+            gc->ops->PolyFillRect(&pixmap->drawable, gc, 1, &rect);
+            FreeScratchGC(gc);
+        }
+        row_bytes = min(old_stride, stride);
+        row_bytes = min(row_bytes, PixmapBytePad(min(width, old_width),
+                                                 pScreen->rootDepth));
+        for (y = 0; y < min(height, old_height); y++)
+            memcpy(bits + y * stride, old_bits + y * old_stride, row_bytes);
+
+        free(pvfb->resizedFb);
+        pvfb->resizedFb = bits;
+        return TRUE;
+    }
+}
