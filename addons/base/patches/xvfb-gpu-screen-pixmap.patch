+        glGetIntegerv(GL_MAX_TEXTURE_SIZE, &max_tex);
+        glGetIntegerv(GL_MAX_RENDERBUFFER_SIZE, &max_rb);
+        if (max_tex > 0 && max_rb > 0) {
+            pvfb->maxFbWidth = min(min(max_tex, max_rb), pvfb->maxFbWidth);
+            pvfb->maxFbHeight = min(min(max_tex, max_rb), pvfb->maxFbHeight);
+        }
+    }
+
     return TRUE;
 }
