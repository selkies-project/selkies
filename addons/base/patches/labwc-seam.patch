diff --git a/src/input/cursor.c b/src/input/cursor.c
index e8ac7d9..bc9e674 100644
--- a/src/input/cursor.c
+++ b/src/input/cursor.c
@@ -4,6 +4,7 @@
 #include <assert.h>
 #include <time.h>
 #include <wlr/config.h>
+#include <wlr/backend/wayland.h>
 #include <wlr/types/wlr_cursor.h>
 #include <wlr/types/wlr_cursor_shape_v1.h>
 #include <wlr/types/wlr_data_device.h>
@@ -891,8 +892,20 @@ preprocess_cursor_motion(struct seat *seat, struct wlr_pointer *pointer,
 	 * specific input device which generated the event. You can pass
 	 * NULL for the device if you want to move the cursor around
 	 * without any input.
+	 *
+	 * A pointer of the Wayland backend is mapped to the output its host
+	 * window backs (see new_pointer()), and wlr_cursor_move() would clamp
+	 * the cursor to that output. The host keeps delivering motion to the
+	 * window a button was pressed in for as long as the button is held,
+	 * with coordinates past its edge, which is how a drag reaches an
+	 * adjacent output: constrain against the whole layout instead, and
+	 * keep the mapping only for the absolute-to-layout conversion.
 	 */
-	wlr_cursor_move(seat->cursor, &pointer->base, dx, dy);
+	struct wlr_input_device *constrain_to = &pointer->base;
+	if (wlr_input_device_is_wl(&pointer->base)) {
+		constrain_to = NULL;
+	}
+	wlr_cursor_move(seat->cursor, constrain_to, dx, dy);
 	double sx, sy;
 	bool notify = cursor_process_motion(time_msec, &sx, &sy);
 	if (notify) {
