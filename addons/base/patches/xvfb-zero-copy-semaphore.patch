xvfb: share GPU semaphores with a client reading what glamor renders

A client that reads a pixmap this server blits the screen into through
another API on the same GPU, such as an encoder's CUDA context, learns of the
blit's completion on the CPU otherwise (a one-pixel GetImage) and only then
queues its own work. Under a GPU-bound client each of the two jobs then waits
a draw of that client for its turn, which halves the capture's rate. A sync
file does not help on NVIDIA, whose GL waits for one on the CPU; a semaphore
both sides share does.

- SELKIES-SEMAPHORE 1.0: QueryVersion, ImportSemaphore(semaphore, drawable)
  with one fd, an OPAQUE_FD semaphore (a Vulkan one, as CUDA imports it),
  SignalSemaphore, which signals once the rendering requested before it has
  completed on the GPU, and FreeSemaphore. A semaphore is binary: each signal
  is for one wait on the client's side.
- glamor imports the semaphore with GL_EXT_semaphore_fd and signals it with
  glSignalSemaphoreEXT and a flush.
- Xvfb offers the extension where every screen came up with glamor and its
  context has GL_EXT_semaphore_fd.

diff --git a/glamor/glamor_egl.c b/glamor/glamor_egl.c
index 082e794..576342c 100644
--- a/glamor/glamor_egl.c
+++ b/glamor/glamor_egl.c
@@ -1783,6 +1783,65 @@ glamor_egl_flush_fenced(ScreenPtr screen)
     return fd;
 }
 
+/*
+ * GPU semaphores a client shares with glamor's context (GL_EXT_semaphore_fd).
+ * Work the client queues on another API of the same GPU can wait on one for
+ * the rendering glamor queued before its signal, with no CPU round trip in
+ * between: a sync file (glamor_egl_flush_fenced) does not do that on every
+ * driver, NVIDIA's waiting for it on the CPU.
+ */
+Bool
+glamor_egl_semaphore_capable(ScreenPtr screen)
+{
+    glamor_screen_private *glamor_priv = glamor_get_screen_private(screen);
+
+    if (!glamor_priv)
+        return FALSE;
+    glamor_make_current(glamor_priv);
+    return epoxy_has_gl_extension("GL_EXT_semaphore_fd");
+}
+
+GLuint
+glamor_egl_import_semaphore(ScreenPtr screen, int fd)
+{
+    GLuint semaphore = 0;
+
+    if (!glamor_egl_semaphore_capable(screen)) {
+        close(fd);
+        return 0;
+    }
+    while (glGetError() != GL_NO_ERROR)
+        ;
+    glGenSemaphoresEXT(1, &semaphore);
+    /* A successful import owns the fd; a failed one leaves it to us. */
+    glImportSemaphoreFdEXT(semaphore, GL_HANDLE_TYPE_OPAQUE_FD_EXT, fd);
+    if (glGetError() != GL_NO_ERROR) {
+        glDeleteSemaphoresEXT(1, &semaphore);
+        close(fd);
+        return 0;
+    }
+    return semaphore;
+}
+
+void
+glamor_egl_signal_semaphore(ScreenPtr screen, GLuint semaphore)
+{
+    glamor_make_current(glamor_get_screen_private(screen));
+    glSignalSemaphoreEXT(semaphore, 0, NULL, 0, NULL, NULL);
+    glFlush();
+}
+
+void
+glamor_egl_free_semaphore(ScreenPtr screen, GLuint semaphore)
+{
+    glamor_screen_private *glamor_priv = glamor_get_screen_private(screen);
+
+    if (!glamor_priv)
+        return;
+    glamor_make_current(glamor_priv);
+    glDeleteSemaphoresEXT(1, &semaphore);
+}
+
 static dri3_screen_info_rec glamor_dri3_info = {
     .version = 2,
 
