#!/usr/bin/env bash
# Install what the workspace lacks of Selkies and an X server, as the KasmVNC
# module does with passwordless sudo, then leave a desktop session running
# behind the app's port. Coder authenticates the app and terminates TLS, so
# Selkies runs on the loopback addresses without a login or TLS of its own.
set -euo pipefail

port=${PORT}
session='${DESKTOP_ENVIRONMENT}'
export SELKIES_WAYLAND=${WAYLAND}

if curl -fsS -o /dev/null "http://localhost:$port/api/health" 2> /dev/null; then
  echo "Selkies already answers on port $port"
  exit 0
fi

need_selkies=
need_xvfb=
command -v selkies-session > /dev/null || need_selkies=1
[ "$SELKIES_WAYLAND" = true ] || command -v Xvfb > /dev/null || need_xvfb=1
if [ -n "$need_selkies$need_xvfb" ]; then
  if ! sudo -n true 2> /dev/null; then
    echo "Installing Selkies or Xvfb needs sudo without a password; install them in the image instead" >&2
    exit 1
  fi
  # shellcheck source=/dev/null
  . /etc/os-release
  if command -v apt-get > /dev/null; then
    sudo apt-get -o DPkg::Lock::Timeout=300 update -qq
    file=(sudo apt-get -o DPkg::Lock::Timeout=300 install -y)
    repo=(sudo apt-get -o DPkg::Lock::Timeout=300 install -y --no-install-recommends)
    pkg="$ID$([ "$ID" = ubuntu ] && echo "$VERSION_ID" || echo "$VERSION_CODENAME")-$(dpkg --print-architecture).deb"
    xvfb=xvfb
  elif command -v dnf > /dev/null; then
    file=(sudo dnf install -y)
    repo=(sudo dnf install -y)
    pkg="$([ "$ID" = fedora ] && echo fc || echo el9)-$(uname -m).rpm"
    xvfb=xorg-x11-server-Xvfb
  elif command -v apk > /dev/null; then
    file=(sudo apk add --allow-untrusted)
    repo=(sudo apk add)
    pkg="$(uname -m).apk"
    xvfb=xvfb
  elif command -v pacman > /dev/null; then
    file=(sudo pacman -U --noconfirm)
    repo=(sudo pacman -S --noconfirm --needed)
    pkg="$(uname -m).pkg.tar.zst"
    xvfb=xorg-server-xvfb
  else
    echo "No package manager Selkies publishes for (apt, dnf, apk, pacman)" >&2
    exit 1
  fi
  if [ -n "$need_selkies" ]; then
    version='${SELKIES_VERSION}'
    if [ -z "$version" ]; then
      # The latest release's tag, from the redirect GitHub answers without its rate-limited API
      version=$(curl -fsSLI -o /dev/null -w '%%{url_effective}' https://github.com/selkies-project/selkies/releases/latest)
      version=$${version##*/}
    fi
    work=$(mktemp -d)
    url=https://github.com/selkies-project/selkies/releases/download/$version
    curl -fsSL -o "$work/selkies-$version-$pkg" "$url/selkies-$version-$pkg"
    # Checked against the release's SHA256SUMS, or the digest GitHub records for
    # the asset where the release predates that file
    if curl -fsL -o "$work/SHA256SUMS" "$url/SHA256SUMS"; then
      sum=$(awk -v f="selkies-$version-$pkg" '$2 == f { print $1 }' "$work/SHA256SUMS")
    else
      sum=$(curl -fsSL "https://api.github.com/repos/selkies-project/selkies/releases/tags/$version" | tr -d ' \n' | sed 's/[,{}]/\n/g' \
        | awk -v f="\"name\":\"selkies-$version-$pkg\"" '$0 == f { hit = 1 } hit && !found && sub(/^"digest":"sha256:/, "") { sub(/"$/, ""); print; found = 1 }') || sum=
    fi
    if [ -z "$sum" ] || [ "$(sha256sum "$work/selkies-$version-$pkg" | cut -d' ' -f1)" != "$sum" ]; then
      echo "selkies-$version-$pkg does not match the SHA-256 its release records ($${sum:-none})" >&2
      rm -rf "$work"
      exit 1
    fi
    "$${file[@]}" "$work/selkies-$version-$pkg"
    rm -rf "$work"
  fi
  [ -z "$need_xvfb" ] || "$${repo[@]}" "$xvfb"
  # The package depends on the PulseAudio client alone, and selkies-session starts only a server the workspace has
  command -v pulseaudio > /dev/null || command -v pipewire-pulse > /dev/null || "$${repo[@]}" pulseaudio
fi

args=(--port="$port" --enable-basic-auth=false --enable-https=false)
[ -z "$session" ] || args+=(--session="$session")
nohup selkies-session "$${args[@]}" > /tmp/selkies-session.log 2>&1 &
echo "Selkies starts on port $port; its log is /tmp/selkies-session.log"
