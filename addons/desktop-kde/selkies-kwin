# Session compositor for the KDE image: kwin_wayland nested inside the capture
# compositor. The base's wayland service execs this with WAYLAND_DISPLAY
# already naming the capture socket, so kwin comes up as its client, opens one
# host window per screen, and runs the XWayland server the session's X11
# applications draw on. Screens are grown and removed at runtime as
# zkde_screencast virtual outputs (KWIN_WAYLAND_NO_PERMISSION_CHECKS in the
# image environment keeps that interface visible to Selkies; the patched kwin
# this image builds registers them — see patches/).
#
# kwin and plasmashell live in different s6 services but must share one
# session bus (kglobalaccel, kwin's own D-Bus API, everything kded serves), so
# both meet on the dbus-session service's fixed socket rather than each
# launching a private bus.
export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/selkies-session-bus"
until [ -S "${XDG_RUNTIME_DIR}/selkies-session-bus" ]; do sleep 0.5; done

export XDG_SESSION_TYPE="wayland"
export XDG_CURRENT_DESKTOP="KDE"
export KDE_SESSION_VERSION="6"
export QT_QPA_PLATFORM="wayland"

# kwin refuses to create the X11 socket directory itself (wlroots makes it),
# so without this XWayland fails outright and every X11 application is lost.
# /tmp is sticky, so the session user can create it; the setuid helper covers
# a /tmp that something else already restricted.
if [ ! -d /tmp/.X11-unix ]; then
  mkdir -pm1777 /tmp/.X11-unix 2>/dev/null || sudo-root mkdir -pm1777 /tmp/.X11-unix \
    || echo "[selkies-kwin] could not create /tmp/.X11-unix; X11 applications will not work"
fi
chmod 1777 /tmp/.X11-unix 2>/dev/null || true

# First-run session defaults, written only where no configuration exists so a
# user's own settings survive restarts: compositing effects off (the desktop
# is streamed, so every animation is bandwidth for nothing) and no autolock (a
# locked container session has no local seat to unlock it; --no-lockscreen
# below covers the running kwin, this covers tools that read the config).
if [ ! -f "${HOME}/.config/kwinrc" ]; then
  kwriteconfig6 --file "${HOME}/.config/kwinrc" --group Compositing --key Enabled false
fi
if [ ! -f "${HOME}/.config/kscreenlockerrc" ]; then
  kwriteconfig6 --file "${HOME}/.config/kscreenlockerrc" --group Daemon --key Autolock false
fi

# The lock screen blocks a session only a disconnected stream would ever
# unlock; kwin picks the first free wayland-N socket and the kde service
# discovers it, so no socket name is pinned here.
exec kwin_wayland --xwayland --no-lockscreen
