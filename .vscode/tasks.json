{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "[build] build joystick interposer library",
            "type": "shell",
            "command": "sudo make install",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}/addons/input-interposer"
            }
        },
        {
            "label": "[build] build the web client",
            "type": "shell",
            "command": "./scripts/ci/build-web.sh",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "[build] build the server",
            "type": "shell",
            "command": "cargo build --release --locked -p selkies",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "[run] Start Selkies",
            "type": "shell",
            "command": "${workspaceFolder}/.devcontainer/features/desktop-selkies/src/start-selkies.sh",
            "problemMatcher": [],
            "options": {
                "env": {
                    "PATH": "${workspaceFolder}/target/release:${env:PATH}"
                }
            }
        },
        {
            "label": "[run] re-build and run Selkies",
            "problemMatcher": [],
            "dependsOrder": "sequence",
            "dependsOn": [
                "[build] build joystick interposer library",
                "[build] build the web client",
                "[build] build the server",
                "[run] Start Selkies"
            ]
        },
        {
            "label": "[workflow] local run devcontainer-feature validate",
            "type": "shell",
            "command": "act -W .github/workflows/devcontainer-feature.yaml -j validate pull_request",
            "problemMatcher": []
        }
    ]
}