{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "baseUrl": "..",
    "paths": {
      "@/*": ["../../addons/selkies-dashboard-wish/src/*"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/client": ["./node_modules/@types/react-dom/client"]
    }
  },
  "include": [
    "../../addons/selkies-web-core/*.js",
    "../../addons/selkies-web-core/lib/*.js",
    "../../addons/selkies-dashboard/src/**/*",
    "../../addons/selkies-dashboard-wish/src/**/*"
  ]
}
