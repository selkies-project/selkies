{
  "name": "selkies-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-assets.mjs && node scripts/generate-python-docs.mjs && node scripts/generate-web-docs.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-assets.mjs && node scripts/generate-python-docs.mjs && node scripts/generate-web-docs.mjs",
    "build": "next build",
    "postbuild": "node scripts/mirror-page-urls.mjs",
    "build:versions": "node scripts/build-versions.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "check-links": "node scripts/check-links.mjs",
    "generate:api": "node scripts/generate-python-docs.mjs && node scripts/generate-web-docs.mjs"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "fumadocs-core": "16.15.10",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-python": "^1.0.2",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.10",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-raw": "^7.0.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3"
  }
}
