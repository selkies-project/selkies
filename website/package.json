{
  "name": "selkies-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-assets.mjs && node scripts/generate-reference.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-assets.mjs && node scripts/generate-reference.mjs",
    "build": "next build",
    "postbuild": "node scripts/drop-full-payloads.mjs",
    "build:versions": "node scripts/build-versions.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "check-links": "node scripts/check-links.mjs",
    "generate:api": "node scripts/generate-reference.mjs"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "fumadocs-core": "16.17.9",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-python": "^1.0.5",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.9",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-raw": "^7.0.0",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "minimatch": "^11.0.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
