+/* x264_mb_predict_mv_pskip for the macroblock at (mb_x, mb_y) of the slice starting at first,
+ * read from the frame's arrays before its cache is loaded, as x264_macroblock_cache_load would
+ * fill it for a progressive frame. */
+static void mb_predict_mv_pskip_frame( x264_t *h, int mb_x, int mb_y, int first, int16_t mv[2] )
+{
+    const int s8x8 = h->mb.i_b8_stride;
+    const int s4x4 = h->mb.i_b4_stride;
+    const int mb_xy = mb_x + mb_y * h->mb.i_mb_stride;
+    const int b8_xy = 2*(mb_y * s8x8 + mb_x);
+    const int b4_xy = 4*(mb_y * s4x4 + mb_x);
+    const int top_row = mb_y > h->i_threadslice_start;
+    const int left     = mb_x > 0 && h->mb.slice_table[mb_xy - 1] == first;
+    const int top      = top_row && h->mb.slice_table[mb_xy - h->mb.i_mb_stride] == first;
+    const int topright = top_row && mb_x < h->mb.i_mb_width - 1 && h->mb.slice_table[mb_xy - h->mb.i_mb_stride + 1] == first;
+    const int topleft  = top_row && mb_x > 0 && h->mb.slice_table[mb_xy - h->mb.i_mb_stride - 1] == first;
+    ALIGNED_4( int16_t zero[2] ) = {0, 0};
+    int refa = left ? h->mb.ref[0][b8_xy - 1] : -2;
+    int refb = top ? h->mb.ref[0][b8_xy - s8x8] : -2;
+    int16_t *mva = left ? h->mb.mv[0][b4_xy - 1] : zero;
+    int16_t *mvb = top ? h->mb.mv[0][b4_xy - s4x4] : zero;
+    if( refa == -2 || refb == -2 || !( (uint32_t)refa | M32( mva ) ) || !( (uint32_t)refb | M32( mvb ) ) )
+    {
+        M32( mv ) = 0;
+        return;
+    }
+    int refc = -2;
+    int16_t *mvc = zero;
+    if( topright )
+    {
+        refc = h->mb.ref[0][b8_xy - s8x8 + 2];
+        mvc = h->mb.mv[0][b4_xy - s4x4 + 4];
+    }
+    else if( topleft )
+    {
+        refc = h->mb.ref[0][b8_xy - s8x8 - 1];
+        mvc = h->mb.mv[0][b4_xy - s4x4 - 1];
+    }
+    int count = (refa == 0) + (refb == 0) + (refc == 0);
+    if( count > 1 )
+        x264_median_mv( mv, mva, mvb, mvc );
+    else if( count == 1 )
+        CP32( mv, refa == 0 ? mva : refb == 0 ? mvb : mvc );
+    else if( refb == -2 && refc == -2 && refa != -2 )
+        CP32( mv, mva );
+    else
+        x264_median_mv( mv, mva, mvb, mvc );
+}
+
+/* Copy the reconstruction of the reference at the vector mv (quarter samples, whole) into the
+ * macroblocks x0 to x1 of row mb_y of the frame being reconstructed. */
+static void mb_copy_run( x264_t *h, int x0, int x1, int mb_y, const int16_t mv[2] )
+{
+    const int n = x1 - x0;
+    if( n <= 0 )
+        return;
+    const int dx = mv[0] >> 2, dy = mv[1] >> 2;
+    for( int p = 0; p < (CHROMA444 ? 3 : 1); p++ )
+    {
+        int stride = h->fdec->i_stride[p];
+        pixel *dst = &h->fdec->plane[p][16 * x0 + 16 * mb_y * stride];
+        const pixel *src = &h->fref[0][0]->plane[p][16 * x0 + dx + (16 * mb_y + dy) * stride];
+        for( int j = 0; j < 16; j++ )
+            memcpy( dst + j*stride, src + j*stride, 16*n*SIZEOF_PIXEL );
+    }
+    if( CHROMA_FORMAT && !CHROMA444 )
+    {
+        int height = 16 >> CHROMA_V_SHIFT;
+        int stride = h->fdec->i_stride[1];
+        pixel *dst = &h->fdec->plane[1][16 * x0 + height * mb_y * stride];
+        const pixel *src = &h->fref[0][0]->plane[1][16 * x0 + dx + (height * mb_y + (dy >> CHROMA_V_SHIFT)) * stride];
+        for( int j = 0; j < height; j++ )
+            memcpy( dst + j*stride, src + j*stride, 16*n*SIZEOF_PIXEL );
+    }
+}
+
 /* Code the run of macroblocks from (mb_x, mb_y) to the end of its row, or to the slice's last
  * macroblock, as the P_SKIP analysis would take each of them, without loading, analysing, or
- * encoding them: the ones the caller's mb_info marks constant, where the mb_info fast skip in
- * x264_macroblock_analyse holds (the reference is the previous frame, at the macroblock's
- * analysis QP or finer, without weighted prediction) and the P_SKIP vector is zero. A row's
- * first macroblock always takes the full path, whose analysis sets the row's vertical vector
- * limits every later macroblock of the row searches and compensates within. The reference's
- * pixels are the reconstruction, copied for the run at once, and each macroblock's state is
+ * encoding them: the ones the caller's mb_info marks constant, or copies of the previous input
+ * at an even vector (x264_mb_copy_check), where the mb_info fast skip in x264_macroblock_analyse
+ * holds (the reference is the previous frame, at the macroblock's analysis QP or finer where it
+ * is read, without weighted prediction) and the vector is the P_SKIP vector. A row's first
+ * macroblock always takes the full path, whose analysis sets the row's vertical vector limits
+ * every later macroblock of the row searches and compensates within. The reference's pixels are
+ * the reconstruction, copied for each run of one vector at once, and each macroblock's state is
  * left as x264_macroblock_cache_save leaves a P_SKIP's: the per-macroblock arrays its neighbours
  * and the next frame read, the intra border backup, and, for the run's last, the right column of
  * the cache the next macroblock takes its left neighbour from. The stream comes out bit for bit
@@ -2778,25 +2854,40 @@ static int macroblock_skip_constant_run( x264_t *h, int mb_x, int mb_y )
     const int first = h->sh.i_first_mb;
     const int row = mb_y * h->mb.i_mb_stride;
     const int end_x = X264_MIN( h->mb.i_mb_width, h->sh.i_last_mb - row + 1 );
+    ALIGNED_4( int16_t run_mv[2] ) = {0, 0};
+    int run_x = mb_x;
     int x = mb_x;
     for( ; x < end_x; x++ )
     {
         const int mb_xy = row + x;
-        if( !(h->fdec->mb_info[mb_xy] & X264_MBINFO_CONSTANT) )
+        const int info = h->fdec->mb_info[mb_xy];
+        ALIGNED_4( int16_t mv[2] ) = {0, 0};
+        if( !(info & X264_MBINFO_CONSTANT)
+            && ( !(info & X264_MBINFO_COPY) || x264_mb_copy_check( h, x, mb_y, mv ) != 2 ) )
             break;
         const int b8_xy = 2*(mb_y * s8x8 + x);
         const int b4_xy = 4*(mb_y * s4x4 + x);
 
-        /* P_SKIP's vector is zero where a neighbour is unavailable or one predicts from reference
-         * 0 with a zero vector (x264_mb_predict_mv_pskip); a median that comes to zero takes the
-         * full path. */
-        int zero = h->mb.slice_table[mb_xy - 1] != first
-                || mb_y == 0 || h->mb.slice_table[mb_xy - h->mb.i_mb_stride] != first;
-        if( !zero )
-            zero = !( h->mb.ref[0][b8_xy - 1] | M32( h->mb.mv[0][b4_xy - 1] ) )
-                || !( h->mb.ref[0][b8_xy - s8x8] | M32( h->mb.mv[0][b4_xy - s4x4] ) );
-        if( !zero )
-            break;
+        if( !M32( mv ) )
+        {
+            /* P_SKIP's vector is zero where a neighbour is unavailable or one predicts from
+             * reference 0 with a zero vector (x264_mb_predict_mv_pskip); a median that comes to
+             * zero takes the full path. */
+            int zero = h->mb.slice_table[mb_xy - 1] != first
+                    || mb_y == 0 || h->mb.slice_table[mb_xy - h->mb.i_mb_stride] != first;
+            if( !zero )
+                zero = !( h->mb.ref[0][b8_xy - 1] | M32( h->mb.mv[0][b4_xy - 1] ) )
+                    || !( h->mb.ref[0][b8_xy - s8x8] | M32( h->mb.mv[0][b4_xy - s4x4] ) );
+            if( !zero )
+                break;
+        }
+        else
+        {
+            ALIGNED_4( int16_t pskip[2] );
+            mb_predict_mv_pskip_frame( h, x, mb_y, first, pskip );
+            if( M32( pskip ) != M32( mv ) )
+                break;
+        }
 
         h->mb.i_mb_x = x;
         h->mb.i_mb_y = mb_y;
@@ -2806,10 +2897,18 @@ static int macroblock_skip_constant_run( x264_t *h, int mb_x, int mb_y )
         int qp = x264_ratecontrol_mb_qp( h );
         if( h->param.rc.i_aq_mode && h->param.analyse.i_subpel_refine < 10 )
             qp = abs(qp - h->mb.i_last_qp) == 1 ? h->mb.i_last_qp : qp;
-        if( h->fref[0][0]->effective_qp[mb_xy] > qp )
