+/* Whether the macroblock at (mb_x, mb_y), which the caller's mb_info marks X264_MBINFO_COPY, is
+ * the previous input picture's at the vector mb_copy names for it: compared where x264 still
+ * holds that picture (h->frames.in_place_prev), the luma always and the chroma at an even vector,
+ * since an odd one moves the chroma sites. Sets mv to the vector in quarter samples. Returns 0
+ * where they differ, the vector reaches past the picture or the level's range, or the picture
+ * is gone; 1 where the luma matches at an odd vector; 2 where the macroblock matches whole. */
+int x264_mb_copy_check( x264_t *h, int mb_x, int mb_y, int16_t mv[2] )
+{
+    x264_frame_t *prev = h->frames.in_place_prev;
+    x264_frame_t *fenc = h->fenc;
+    if( !prev || !h->fdec->mb_copy || CHROMA_FORMAT != CHROMA_420 || prev->i_csp != fenc->i_csp )
+        return 0;
+    const int mb_xy = mb_x + mb_y * h->mb.i_mb_stride;
+    const int dx = h->fdec->mb_copy[mb_xy][0];
+    const int dy = h->fdec->mb_copy[mb_xy][1];
+    const int x = 16 * mb_x, y = 16 * mb_y, sx = x + dx, sy = y + dy;
+    const int range = h->param.analyse.i_mv_range;
+    if( x + 16 > h->param.i_width || y + 16 > h->param.i_height || sx < 0 || sy < 0
+        || sx + 16 > h->param.i_width || sy + 16 > h->param.i_height
+        || abs(dx) >= range || abs(dy) >= range )
+        return 0;
+    const pixel *cur = fenc->plane[0] + y * fenc->i_stride[0] + x;
+    const pixel *src = prev->plane[0] + sy * prev->i_stride[0] + sx;
+    for( int j = 0; j < 16; j++ )
+        if( memcmp( cur + j * fenc->i_stride[0], src + j * prev->i_stride[0], 16 * SIZEOF_PIXEL ) )
+            return 0;
+    mv[0] = 4 * dx;
+    mv[1] = 4 * dy;
+    if( (dx | dy) & 1 )
+        return 1;
+    cur = fenc->plane[1] + (y >> 1) * fenc->i_stride[1] + x;
+    src = prev->plane[1] + (sy >> 1) * prev->i_stride[1] + sx;
+    for( int j = 0; j < 8; j++ )
+        if( memcmp( cur + j * fenc->i_stride[1], src + j * prev->i_stride[1], 16 * SIZEOF_PIXEL ) )
+            return 1;
+    return 2;
+}
+
+/* The coarsest effective QP among the reference's macroblocks a copy of the macroblock at
+ * (mb_x, mb_y) from the vector mv (quarter samples) reads. */
+int x264_mb_copy_source_qp( x264_t *h, int mb_x, int mb_y, const int16_t mv[2] )
+{
+    const int sx = 16 * mb_x + (mv[0] >> 2), sy = 16 * mb_y + (mv[1] >> 2);
+    const int x0 = sx >> 4, x1 = (sx + 15) >> 4, y0 = sy >> 4, y1 = (sy + 15) >> 4;
+    const uint8_t *effective_qp = h->fref[0][0]->effective_qp;
+    int qp = 0;
+    for( int y = y0; y <= y1; y++ )
+        for( int x = x0; x <= x1; x++ )
+            qp = X264_MAX( qp, effective_qp[x + y * h->mb.i_mb_stride] );
+    return qp;
+}
