include Cargo.toml
include Cargo.lock
include build.rs
recursive-include src *
recursive-include protocols *
recursive-include nvcodec-sys *
recursive-include codec-sys *
recursive-include va-sys *
recursive-include patches *.patch
include scripts/build-x264.sh scripts/build-x265.sh scripts/build-libvpx.sh scripts/build-svtav1.sh scripts/build-kvazaar.sh
recursive-exclude src *.so *.pyc
prune target
prune nvcodec-sys/target
prune codec-sys/target
prune va-sys/target
include LICENSE
include LICENSES.md
include pyproject.toml
include README.md
include setup.py
