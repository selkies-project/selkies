From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: thelamer <ryankuba@gmail.com>
Date: Sat, 7 Nov 2026 18:33:17 -0500
Subject: [PATCH 4/4] Apply caller QP offsets without adaptive quantization
 (rc.bQpOffsets)

A picture's quantOffsets reach the quantizer only under adaptive quantization, and a strength
of 0 turns adaptive quantization off, offsets and all, so a caller that wants its offsets alone
runs the variance pass at a strength that moves nothing, a pass over every block of every
frame. qp-offsets keeps adaptive quantization's per-block quantizer at strength 0, where the
pass is skipped and the offsets apply as given. A session without offsets codes the same stream;
a still 1920x1080 frame took 2.8 ms on eight threads where it took 3.1, and at 2560x1600 4.6
where it took 5.5.
---
 source/common/param.cpp    | 3 +++
 source/encoder/encoder.cpp | 2 +-
 source/x265.h              | 6 ++++++
 3 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/source/common/param.cpp b/source/common/param.cpp
index c09214d..a035ef4 100755
--- a/source/common/param.cpp
+++ b/source/common/param.cpp
@@ -871,6 +871,7 @@ int x265_zone_param_parse(x265_param* p, const char* name, const char* value)
     }
     OPT("aq-mode") p->rc.aqMode = atoi(value);
     OPT("aq-strength") p->rc.aqStrength = atof(value);
+    OPT("qp-offsets") p->rc.bQpOffsets = atobool(value);
     OPT("nr-intra") p->noiseReductionIntra = atoi(value);
     OPT("nr-inter") p->noiseReductionInter = atoi(value);
     OPT("limit-modes") p->limitModes = atobool(value);
@@ -1176,6 +1177,7 @@ int x265_param_parse(x265_param* p, const char* name, const char* value)
     OPT("qblur") p->rc.qblur = atof(value);
     OPT("aq-mode") p->rc.aqMode = atoi(value);
     OPT("aq-strength") p->rc.aqStrength = atof(value);
+    OPT("qp-offsets") p->rc.bQpOffsets = atobool(value);
     OPT("vbv-maxrate") p->rc.vbvMaxBitrate = atoi(value);
     OPT("vbv-bufsize") p->rc.vbvBufferSize = atoi(value);
     OPT("vbv-init")    p->rc.vbvBufferInit = atof(value);
@@ -2853,6 +2855,7 @@ void x265_copy_params(x265_param* dst, x265_param* src)
     dst->rc.qpStep = src->rc.qpStep;
     dst->rc.aqMode = src->rc.aqMode;
     dst->rc.aqStrength = src->rc.aqStrength;
+    dst->rc.bQpOffsets = src->rc.bQpOffsets;
     dst->rc.vbvBufferSize = src->rc.vbvBufferSize;
     dst->rc.vbvMaxBitrate = src->rc.vbvMaxBitrate;
 
diff --git a/source/encoder/encoder.cpp b/source/encoder/encoder.cpp
index 4571310..2621207 100644
--- a/source/encoder/encoder.cpp
+++ b/source/encoder/encoder.cpp
@@ -4106,7 +4106,7 @@ void Encoder::configure(x265_param *p)
         x265_log(p, X265_LOG_WARNING, "Max TU size should be less than or equal to max CU size, setting max TU size = %d\n", p->maxCUSize);
         p->maxTUSize = p->maxCUSize;
     }
-    if (p->rc.aqStrength == 0 && p->rc.cuTree == 0)
+    if (p->rc.aqStrength == 0 && p->rc.cuTree == 0 && !p->rc.bQpOffsets)
     {
         p->rc.aqMode = X265_AQ_NONE;
         p->rc.hevcAq = 0;
diff --git a/source/x265.h b/source/x265.h
index faa0262..cebad6e 100644
--- a/source/x265.h
+++ b/source/x265.h
@@ -1761,6 +1761,12 @@ typedef struct x265_param
          * AQ is enabled. Default value: 1.0. Acceptable values between 0.0 and 3.0 */
         double    aqStrength;
 
+        /* Keep adaptive quantization's per-block quantizer at strength 0, so the
+         * offsets a picture carries (x265_picture.quantOffsets) apply as given
+         * without the variance pass that a strength would weigh them against.
+         * Default 0: strength 0 turns adaptive quantization off, offsets and all. */
+        int       bQpOffsets;
+
         /* Delta QP range by QP adaptation based on a psycho-visual model.
          * Acceptable values between 1.0 to 6.0 */
         double    qpAdaptationRange;
