+/* whether every 16x16 block of the picture under the CU is one the caller marked constant */
+bool Analysis::cuConstant(const CUData& parentCTU, const CUGeom& cuGeom) const
+{
+    const uint8_t* map = m_frame->m_constantBlocks;
+    uint32_t width = m_param->sourceWidth;
+    uint32_t height = m_param->sourceHeight;
+    uint32_t cols = (width + 15) >> 4;
+    uint32_t x0 = parentCTU.m_cuPelX + g_zscanToPelX[cuGeom.absPartIdx];
+    uint32_t y0 = parentCTU.m_cuPelY + g_zscanToPelY[cuGeom.absPartIdx];
+    uint32_t size = 1u << cuGeom.log2CUSize;
+    uint32_t x1 = X265_MIN(x0 + size, width);
+    uint32_t y1 = X265_MIN(y0 + size, height);
+    if (x0 >= width || y0 >= height)
+        return false;
+    for (uint32_t by = y0 >> 4; by < (y1 + 15) >> 4; by++)
+        for (uint32_t bx = x0 >> 4; bx < (x1 + 15) >> 4; bx++)
+            if (!map[by * cols + bx])
+                return false;
+    return true;
+}
+
+/* code the CU as a 2Nx2N skip from the zero-motion merge candidate of the first reference,
+ * whose picture the caller says it already holds, and set md.bestMode to it; false, leaving
+ * md.bestMode as it was, where no merge candidate is that vector */
+bool Analysis::checkConstantSkip(Mode& skip, const CUGeom& cuGeom)
+{
+    ModeDepth& md = m_modeDepth[cuGeom.depth];
+
+    skip.initCosts();
+    skip.cu.setPartSizeSubParts(SIZE_2Nx2N);
+    skip.cu.setPredModeSubParts(MODE_INTER);
+    skip.cu.m_mergeFlag[0] = true;
+
+    MVField candMvField[MRG_MAX_NUM_CANDS][2];
+    uint8_t candDir[MRG_MAX_NUM_CANDS];
+    uint32_t numMergeCand = skip.cu.getInterMergeCandidates(0, 0, candMvField, candDir);
+    int cand = -1;
+    for (uint32_t i = 0; i < numMergeCand; i++)
+    {
+        if (candDir[i] == 1 && candMvField[i][0].refIdx == 0 && !candMvField[i][0].mv.notZero())
+        {
+            cand = (int)i;
+            break;
+        }
+    }
+    if (cand < 0)
+        return false;
+
+    skip.cu.m_mvpIdx[0][0] = (uint8_t)cand;
+    skip.cu.m_interDir[0] = candDir[cand];
+    skip.cu.m_mv[0][0] = candMvField[cand][0].mv;
+    skip.cu.m_mv[1][0] = candMvField[cand][1].mv;
+    skip.cu.m_refIdx[0][0] = (int8_t)candMvField[cand][0].refIdx;
+    skip.cu.m_refIdx[1][0] = (int8_t)candMvField[cand][1].refIdx;
+    PredictionUnit pu(skip.cu, cuGeom, 0);
+    motionCompensation(skip.cu, pu, skip.predYuv, true, m_csp != X265_CSP_I400);
+    skip.sa8dBits = getTUBits(cand, numMergeCand);
+    skip.sa8dCost = m_rdCost.calcRdSADCost(0, skip.sa8dBits);
+    if (m_param->rdLevel)
+        encodeResAndCalcRdSkipCU(skip);
+    else
+    {
+        skip.reconYuv.copyFromYuv(skip.predYuv);
+        skip.cu.setPredModeSubParts(MODE_SKIP);
+    }
+
+    md.bestMode = &skip;
+    md.bestMode->cu.setPUInterDir(candDir[cand], 0, 0);
+    md.bestMode->cu.setPUMv(0, candMvField[cand][0].mv, 0, 0);
+    md.bestMode->cu.setPUMv(1, candMvField[cand][1].mv, 0, 0);
+    md.bestMode->cu.setPURefIdx(0, (int8_t)candMvField[cand][0].refIdx, 0, 0);
+    md.bestMode->cu.setPURefIdx(1, (int8_t)candMvField[cand][1].refIdx, 0, 0);
+    checkDQP(*md.bestMode, cuGeom);
+    return true;
+}
+
