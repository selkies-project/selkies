     }
 }
 
-void LookaheadTLD::lowresIntraEstimate(Lowres& fenc, uint32_t qgSize)
+/* whether lowres block (cuX, cuY) and the neighbours its intra estimate reads samples from
+ * (left, above-left, above, above-right, below-left) are blocks the caller marked constant */
+static bool intraEstimateConstant(const uint8_t* constant, int cuX, int cuY, int widthInCU, int heightInCU)
+{
+    static const int dx[6] = { 0, -1, -1, 0, 1, -1 };
+    static const int dy[6] = { 0, 0, -1, -1, -1, 1 };
+    for (int i = 0; i < 6; i++)
+    {
+        int x = cuX + dx[i], y = cuY + dy[i];
+        if (x < 0 || y < 0 || x >= widthInCU || y >= heightInCU)
+            continue;
+        if (!constant[y * widthInCU + x])
+            return false;
+    }
+    return true;
+}
+
+/* prev and constant, where given, name the frame before and the blocks the caller marked
+ * unchanged since it: a block whose samples, and the neighbours' it predicts from, are the
+ * frame before's keeps that frame's intra estimate and mode, which the estimate would compute
+ * again to the same value. The estimate is kept in intraEstimate, since a VBV rate control
+ * weights intraCost in place by the block's quantizer offset as the frame is coded */
+void LookaheadTLD::lowresIntraEstimate(Lowres& fenc, uint32_t qgSize, const Lowres* prev, const uint8_t* constant)
 {
     ALIGN_VAR_32(pixel, prediction[X265_LOWRES_CU_SIZE * X265_LOWRES_CU_SIZE]);
     pixel fencIntra[X265_LOWRES_CU_SIZE * X265_LOWRES_CU_SIZE];
@@ -731,6 +753,15 @@ void LookaheadTLD::lowresIntraEstimate(Lowres& fenc, uint32_t qgSize)
             const intptr_t pelOffset = cuSize * cuX + cuSize * cuY * fenc.lumaStride;
             pixel *pixCur = fenc.lowresPlane[0] + pelOffset;
 
+            int cost, icost = me.COST_MAX;
+            uint32_t ilowmode = 0;
+            if (prev && constant && intraEstimateConstant(constant, cuX, cuY, widthInCU, heightInCU))
+            {
+                icost = prev->intraEstimate[cuXY];
+                ilowmode = prev->intraMode[cuXY];
+            }
+            else
+            {
             /* copy fenc pixels */
             primitives.cu[sizeIdx].copy_pp(fencIntra, cuSize, pixCur, fenc.lumaStride);
 
@@ -742,9 +773,6 @@ void LookaheadTLD::lowresIntraEstimate(Lowres& fenc, uint32_t qgSize)
 
             primitives.cu[sizeIdx].intra_filter(samples, filtered);
 
-            int cost, icost = me.COST_MAX;
-            uint32_t ilowmode = 0;
-
             /* DC and planar */
             primitives.cu[sizeIdx].intra_pred[DC_IDX](prediction, cuSize, samples, 0, cuSize <= 16);
             cost = satd(fencIntra, cuSize, prediction, cuSize);
@@ -784,9 +812,11 @@ void LookaheadTLD::lowresIntraEstimate(Lowres& fenc, uint32_t qgSize)
             COPY2_IF_LT(icost, acost, ilowmode, alowmode);
 
             icost += intraPenalty + lowresPenalty; /* estimate intra signal cost */
+            }
 
             fenc.lowresCosts[0][0][cuXY] = (uint16_t)(X265_MIN(icost, LOWRES_COST_MASK) | (0 << LOWRES_COST_SHIFT));
             fenc.intraCost[cuXY] = icost;
+            fenc.intraEstimate[cuXY] = icost;
             fenc.intraMode[cuXY] = (uint8_t)ilowmode;
             /* do not include edge blocks in the 
             frame cost estimates, they are not very accurate */
@@ -1755,7 +1785,13 @@ void PreLookaheadGroup::processTasks(int workerThreadID)
         if (m_lookahead.m_param->bHistBasedSceneCut)
             tld.collectPictureStatistics(preFrame);
 
-        tld.lowresIntraEstimate(preFrame->m_lowres, m_lookahead.m_param->rc.qgSize);
+        /* the blocks the picture marks constant keep the estimates of the frame before, where
+         * the lookahead's last non-B frame, alive as this frame's reference, is that frame */
+        const Lowres* prev = m_lookahead.m_lastNonB;
+        const uint8_t* constant = preFrame->m_constantBlocks;
+        if (!prev || !prev->intraEstimate || prev->frameNum + 1 != preFrame->m_lowres.frameNum)
+            constant = NULL;
+        tld.lowresIntraEstimate(preFrame->m_lowres, m_lookahead.m_param->rc.qgSize, prev, constant);
         preFrame->m_lowresInit = true;
 
         m_lock.acquire();
diff --git a/source/encoder/slicetype.h b/source/encoder/slicetype.h
