-        h->frames.mb_input_changed = x264_malloc( mb_w * mb_h * sizeof(int) );
+        h->frames.mb_input_changed = x264_malloc( mb_count * sizeof(int) );
         if( !h->frames.mb_input_changed )
-            return 0;
-        for( int i = 0; i < mb_w * mb_h; i++ )
