 }
 
+/* The planes of a frame of an encoder opened with param, as frame_new lays them out: the buffers
+ * a picture is encoded from in place (X264_CSP_IN_PLACE, x264_param_input_layout). */
+int x264_frame_input_layout( const x264_param_t *param, int i_stride[2], int i_offset[2], int64_t i_size[2] )
+{
+    if( HIGH_BIT_DEPTH || frame_internal_csp( param->i_csp ) != X264_CSP_NV12 || param->b_interlaced
+        || param->b_opencl || param->i_width <= 0 || param->i_height <= 0 )
+        return -1;
+    int i_width = ALIGN( param->i_width, 16 );
+    int i_lines = ALIGN( param->i_height, 16 );
+    int stride = align_stride( i_width + PADH2, frame_align( param->cpu ), FRAME_DISALIGN );
+    for( int p = 0; p < 2; p++ )
+    {
+        int lines = (i_lines >> p) + 2 * (PADV >> p);
+        i_stride[p] = stride * SIZEOF_PIXEL;
+        i_offset[p] = (stride * (PADV >> p) + PADH_ALIGN) * SIZEOF_PIXEL;
+        i_size[p] = (int64_t)(p ? stride * lines : align_plane_size( stride * lines, FRAME_DISALIGN )) * SIZEOF_PIXEL;
+    }
+    return 0;
+}
