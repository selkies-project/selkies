+/* An input frame whose planes point at the caller's picture (X264_CSP_IN_PLACE) keeps them so
+ * through the next call, which takes it as the previous input, and no longer. */
+int x264_encoder_encode( x264_t *h, x264_nal_t **pp_nal, int *pi_nal, x264_picture_t *pic_in, x264_picture_t *pic_out )
+{
+    x264_frame_t *previous = h->frames.in_place;
+    h->frames.in_place = NULL;
+    int ret = encoder_encode( h, pp_nal, pi_nal, pic_in, pic_out );
+    if( previous && previous != h->frames.in_place )
+        x264_frame_restore_planes( previous );
+    return ret;
+}
+
+void x264_encoder_release_input( x264_t *h )
+{
+    if( h->frames.in_place )
+        x264_frame_restore_planes( h->frames.in_place );
+    h->frames.in_place = NULL;
+}
