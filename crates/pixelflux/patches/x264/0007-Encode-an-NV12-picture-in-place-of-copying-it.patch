@@ -974,6 +975,28 @@ X264_API int x264_encoder_headers( x264_t *, x264_nal_t **pp_nal, int *pi_nal );
  *      returns negative on error and zero if no NAL units returned.
  *      the payloads of all output NALs are guaranteed to be sequential in memory. */
 X264_API int x264_encoder_encode( x264_t *, x264_nal_t **pp_nal, int *pi_nal, x264_picture_t *pic_in, x264_picture_t *pic_out );
+/* x264_param_input_layout:
+ *      the planes an encoder opened with these parameters encodes a picture from in place, without
+ *      copying it: 8-bit NV12 (X264_CSP_NV12 | X264_CSP_IN_PLACE) with i_stride[p] bytes a row,
+ *      img.plane[p] i_offset[p] bytes into a buffer of i_size[p] bytes that starts on a multiple
+ *      of X264_IN_PLACE_ALIGN bytes. The buffers are laid out as the encoder's own: x264 reads the
+ *      picture, the padding beside it, and writes the columns and rows past it that round it up to
+ *      whole macroblocks, and one more of each.
+ *      The encoder takes the picture in place where every frame is encoded in the call it is passed
+ *      to (sliced threads or one thread, no lookahead delay, progressive), and the strides and the
+ *      alignment match; it copies the picture otherwise, which codes the same stream.
+ *      A picture passed in place is read through the next x264_encoder_encode, which reads it as
+ *      the previous input, so the caller keeps its buffers unchanged until that call returns
+ *      or until x264_encoder_release_input.
+ *      returns 0, or negative where these parameters take no picture in place (another chroma
+ *      format or bit depth, interlacing, OpenCL). */
+#define X264_IN_PLACE_ALIGN 64
+X264_API int x264_param_input_layout( const x264_param_t *, int i_stride[2], int i_offset[2], int64_t i_size[2] );
+/* x264_encoder_release_input:
+ *      stop reading the last picture passed in place (X264_CSP_IN_PLACE), which the next
+ *      x264_encoder_encode then does not read as the previous input, so the caller can
+ *      change or free its buffers. */
+X264_API void x264_encoder_release_input( x264_t * );
