-    dst->i_input_frame = n;
+}
+
+/* Point dst's planes at the caller's 8-bit NV12 picture (X264_CSP_IN_PLACE) in place of copying
+ * it, where every read of it falls within the x264_encoder_encode it is passed to and the next
+ * one, which takes it as the previous input: frame threads and a lookahead delay keep a frame
+ * longer. The strides and the alignment are checked against x264_param_input_layout, the padding
+ * past them cannot be. Returns 0, having pointed nothing, where the picture is to be copied. */
+static int frame_point_picture( x264_t *h, x264_frame_t *dst, x264_picture_t *src )
+{
+    if( HIGH_BIT_DEPTH || !(src->img.i_csp & X264_CSP_IN_PLACE)
+        || (src->img.i_csp & ~X264_CSP_IN_PLACE) != X264_CSP_NV12 || dst->i_csp != X264_CSP_NV12
+        || h->i_thread_frames > 1 || h->frames.i_delay || PARAM_INTERLACED || h->param.b_opencl )
+        return 0;
+    for( int p = 0; p < 2; p++ )
+        if( src->img.i_stride[p] != dst->i_stride[p] * SIZEOF_PIXEL
+            || (intptr_t)src->img.plane[p] & (X264_IN_PLACE_ALIGN - 1) )
+            return 0;
+    for( int p = 0; p < 2; p++ )
+    {
+        dst->own_plane[p] = dst->plane[p];
+        dst->plane[p] = (pixel*)src->img.plane[p];
+    }
+    dst->i_own_planes_frame = dst->i_planes_frame;
+    dst->i_input_frame = dst->i_planes_frame = h->frames.i_input;
+    h->frames.in_place = dst;
+    return 1;
+}
+
+/* Point a frame whose planes point at the caller's picture back at its own, which hold the input
+ * frame they held before. */
+void x264_frame_restore_planes( x264_frame_t *frame )
+{
+    if( !frame->own_plane[0] )
+        return;
+    for( int p = 0; p < 2; p++ )
+    {
+        frame->plane[p] = frame->own_plane[p];
+        frame->own_plane[p] = NULL;
+    }
+    frame->i_planes_frame = frame->i_own_planes_frame;
+}
+
+/* Copy into dst only the macroblocks of src that changed since the input frame dst's planes
+ * hold, for planar 4:2:0 and 4:4:4: the input frames are recycled, so on a screen where little
+ * changes most of a recycled frame already holds the picture (frame_input_changed). Returns 0, having copied nothing, where the whole picture is to be
+ * copied: another format, or a frame holding nothing of the stream. */
+static int frame_copy_changed( x264_t *h, x264_frame_t *dst, x264_picture_t *src, int i_csp )
+{
+    const int n = h->frames.i_input;
+    const int mb_w = h->mb.i_mb_width, mb_h = h->mb.i_mb_height;
+    int *changed = h->frames.mb_input_changed;
+    int held = dst->i_planes_frame;
+    dst->i_input_frame = dst->i_planes_frame = n;
+    if( !changed )
+        return 0;
     int planar420 = i_csp == X264_CSP_I420;
     int planar444 = i_csp == X264_CSP_I444;
     if( held < 0 || h->frames.i_input_all_changed > held || !(planar420 || planar444) )
@@ -492,7 +573,9 @@ int x264_frame_copy_picture( x264_t *h, x264_frame_t *dst, x264_picture_t *src )
 
     uint8_t *pix[3];
     int stride[3];
-    if( frame_copy_changed( h, dst, src, i_csp ) )
+    x264_frame_restore_planes( dst );
+    frame_input_changed( h, src );
+    if( frame_point_picture( h, dst, src ) || frame_copy_changed( h, dst, src, i_csp ) )
         return 0;
     if( i_csp == X264_CSP_YUYV || i_csp == X264_CSP_UYVY )
     {
