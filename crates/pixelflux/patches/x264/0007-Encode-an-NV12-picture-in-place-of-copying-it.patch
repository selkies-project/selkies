-static int frame_copy_changed( x264_t *h, x264_frame_t *dst, x264_picture_t *src, int i_csp )
+/* Record the macroblocks the input frame h->frames.i_input changed, from the caller's mb_info
+ * (X264_MBINFO_CONSTANT), a frame without it changing all of them. */
+static void frame_input_changed( x264_t *h, x264_picture_t *src )
 {
     const int n = h->frames.i_input;
-    const int mb_w = h->mb.i_mb_width, mb_h = h->mb.i_mb_height;
