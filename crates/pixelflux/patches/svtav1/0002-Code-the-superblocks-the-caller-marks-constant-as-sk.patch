diff --git a/Source/Lib/Codec/pcs.c b/Source/Lib/Codec/pcs.c
index b8a63a0..a4b39b5 100644
--- a/Source/Lib/Codec/pcs.c
+++ b/Source/Lib/Codec/pcs.c
@@ -1581,3 +1581,22 @@ EbErrorType svt_aom_me_creator(EbPtr* object_dbl_ptr, EbPtr object_init_data_ptr
 
     return EB_ErrorNone;
 }
+
+bool svt_aom_constant_blocks_cover(const PictureParentControlSet* ppcs, uint32_t x, uint32_t y, uint32_t w,
+                                   uint32_t h) {
+    const uint8_t* map = ppcs->input_ptr ? ppcs->input_ptr->constant_blocks : NULL;
+    if (!map || !ppcs->enhanced_pic)
+        return false;
+    const uint32_t width  = ppcs->enhanced_pic->width - ppcs->scs->max_input_pad_right;
+    const uint32_t height = ppcs->enhanced_pic->height - ppcs->scs->max_input_pad_bottom;
+    if (x >= width || y >= height)
+        return false;
+    const uint32_t cols = (width + 15) >> 4;
+    const uint32_t x1   = MIN(x + w, width);
+    const uint32_t y1   = MIN(y + h, height);
+    for (uint32_t by = y >> 4; by < (y1 + 15) >> 4; by++)
+        for (uint32_t bx = x >> 4; bx < (x1 + 15) >> 4; bx++)
+            if (!map[by * cols + bx])
+                return false;
+    return true;
+}
