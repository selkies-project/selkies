+/* The index of wrapper in the pool of res, or -1. */
+static int pool_index(const EbSystemResource* res, const EbObjectWrapper* wrapper) {
+    if (!res)
+        return -1;
+    for (uint32_t i = 0; i < res->object_total_count; i++)
+        if (res->wrapper_ptr_pool[i] == wrapper)
+            return (int)i;
+    return -1;
+}
+
+/* Size the stale maps for pictures of `blocks` 16x16 blocks, every block of every buffer stale
+ * where they did not already fit. Returns false where they could not be allocated. */
+static bool size_stale_maps(EbEncHandle* h, uint32_t blocks) {
+    if (h->stale_blocks == blocks && h->y8b_stale && h->in_stale)
+        return true;
+    free_stale_maps(h);
+    const uint32_t y8b_count = h->input_y8b_buffer_resource_ptr->object_total_count;
+    const uint32_t in_count  = h->input_buffer_resource_ptr->object_total_count;
+    h->y8b_stale             = (uint8_t**)calloc(y8b_count, sizeof(uint8_t*));
+    h->in_stale              = (uint8_t**)calloc(in_count, sizeof(uint8_t*));
+    if (!h->y8b_stale || !h->in_stale) {
+        free_stale_maps(h);
+        return false;
+    }
+    for (uint32_t i = 0; i < y8b_count; i++) {
+        h->y8b_stale[i] = (uint8_t*)malloc(blocks);
+        if (!h->y8b_stale[i]) {
+            free_stale_maps(h);
+            return false;
+        }
+        memset(h->y8b_stale[i], 1, blocks);
+    }
+    for (uint32_t i = 0; i < in_count; i++) {
+        h->in_stale[i] = (uint8_t*)malloc(blocks);
+        if (!h->in_stale[i]) {
+            free_stale_maps(h);
+            return false;
+        }
+        memset(h->in_stale[i], 1, blocks);
+    }
+    h->stale_blocks = blocks;
+    return true;
+}
+
+/* Note this picture's changes in the stale maps of the pool's buffers: the blocks constant
+ * leaves changed, or every block where constant is NULL; the buffer at target, which takes the
+ * picture, is marked whole where it was resized. */
+static void note_changes(uint8_t** stale, const EbSystemResource* res, int target, const uint8_t* constant,
+                         uint32_t blocks, bool target_resized) {
+    for (uint32_t i = 0; i < res->object_total_count; i++) {
+        uint8_t* map = stale[i];
+        if ((int)i == target) {
+            if (target_resized || !constant)
+                memset(map, 1, blocks);
+            else
+                for (uint32_t b = 0; b < blocks; b++) map[b] |= !constant[b];
+        } else if (!constant) {
+            memset(map, 1, blocks);
+        } else {
+            for (uint32_t b = 0; b < blocks; b++) map[b] |= !constant[b];
+        }
+    }
+}
+
+/* Copy the runs of 16x16 blocks `copy` marks, in a picture of mb_cols x mb_rows blocks whose
+ * sample plane is width x height, from src to dst; ss_x and ss_y are the plane's subsampling. */
+static void copy_blocks_8bit(const uint8_t* copy, uint32_t mb_cols, uint32_t mb_rows, uint8_t* src,
+                             uint32_t src_stride, uint8_t* dst, uint32_t dst_stride, uint32_t width,
+                             uint32_t height, uint8_t ss_x, uint8_t ss_y) {
+    for (uint32_t row = 0; row < mb_rows; row++) {
+        const uint8_t* marks = copy + row * mb_cols;
+        uint32_t       y     = (row * 16) >> ss_y;
+        uint32_t       h     = ((16 + ss_y) >> ss_y);
+        if (y >= height)
+            break;
+        if (y + h > height)
+            h = height - y;
+        uint32_t col = 0;
+        while (col < mb_cols) {
+            while (col < mb_cols && !marks[col]) col++;
+            if (col == mb_cols)
+                break;
+            uint32_t end = col;
+            while (end < mb_cols && marks[end]) end++;
+            uint32_t x = (col * 16) >> ss_x;
+            uint32_t w = ((end - col) * 16 + ss_x) >> ss_x;
+            if (x < width) {
+                if (x + w > width)
+                    w = width - x;
+                svt_av1_copy_wxh_8bit(src + y * src_stride + x, src_stride, dst + y * dst_stride + x, dst_stride, h, w);
+            }
+            col = end;
+        }
+    }
+}
