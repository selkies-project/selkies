     //set live count to 1 to be decremented at the end of the encode in RC, and released
@@ -5607,14 +5748,48 @@ EB_API EbErrorType svt_av1_enc_send_picture(EbComponentType* svt_enc_component,
     const size_t chroma_height = (luma_height + subsampling_y) >> subsampling_y;
     const size_t read_size     = (luma_width * luma_height + 2 * chroma_width * chroma_height) << is_16bit_input;
 
+    // A buffer holds the picture it last took, so a picture with a constant-block map copies
+    // only the blocks the map leaves changed and those changed since the buffer last held the
+    // picture (its stale map); the other buffers note this picture's changes for their own
+    // next copy. Everything is copied where there is no map, the input is wider than a byte,
+    // the first pass downsamples, or a buffer was resized.
+    const uint32_t mb_cols = (uint32_t)((luma_width + 15) >> 4);
+    const uint32_t mb_rows = (uint32_t)((luma_height + 15) >> 4);
+    const int      y8b_idx = pool_index(enc_handle_ptr->input_y8b_buffer_resource_ptr, y8b_wrapper);
+    const int      in_idx  = pool_index(enc_handle_ptr->input_buffer_resource_ptr, eb_wrapper_ptr);
+    const uint8_t* constant = app_hdr->p_buffer != NULL ? app_hdr->constant_blocks : NULL;
+    const bool     partial  = constant && !is_16bit_input && !scs->first_pass_downsample && y8b_idx >= 0 &&
+        in_idx >= 0 && size_stale_maps(enc_handle_ptr, mb_cols * mb_rows);
+    const uint8_t* copy_luma = NULL;
+    const uint8_t* copy_chroma = NULL;
+    if (enc_handle_ptr->stale_blocks == mb_cols * mb_rows) {
+        note_changes(enc_handle_ptr->y8b_stale, enc_handle_ptr->input_y8b_buffer_resource_ptr, y8b_idx,
+                     partial ? constant : NULL, mb_cols * mb_rows, y8b_resized);
+        note_changes(enc_handle_ptr->in_stale, enc_handle_ptr->input_buffer_resource_ptr, in_idx,
+                     partial ? constant : NULL, mb_cols * mb_rows, in_resized);
+        if (partial) {
+            copy_luma   = enc_handle_ptr->y8b_stale[y8b_idx];
+            copy_chroma = enc_handle_ptr->in_stale[in_idx];
+        }
+    }
     if (app_hdr->p_buffer != NULL && read_size > app_hdr->n_filled_len) {
         // memset the library input buffer(s) if the API input buffer is not large enough
         // this operation is necessary to avoid a potential crash when processing an invalid input
         // the library will still process the current input and then exit
         memset_input_buffer(scs, lib_reg_hdr, lib_y8b_hdr, app_hdr, 0);
         enc_handle_ptr->is_prev_valid = false;
+        if (copy_luma)
