  The window manager's built-in right-click menu on the desktop, compiled into
  it. The menu.xml found along its configuration directories, an image's
  /etc/xdg/openbox/menu.xml or a user's ~/.config/openbox/menu.xml, adds to it:
  that file's root-menu items go above these, and any other menu it defines
  replaces the one of its id here. It offers the desktop's own commands, which the window manager
  leaves out while the application runs alone, every installed application by
  category, and the open windows. The selkies-applications menu
  is the window manager's own, filled from the installed desktop entries with
  their icons, and an item written without an icon gets the one of the
  application it starts. There is no Exit: the window manager is the server's,
  and leaving it only has it started again.
-->
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="selkies-applications" label="Applications" icon="applications-all" />
  <menu id="root-menu" label="Selkies">
    <item label="New Folder" icon="folder-new">
      <action name="Execute"><command>selkies-desktop --new-folder</command></action>
    </item>
    <item label="Desktop Settings" icon="preferences-desktop">
      <action name="Execute"><command>selkies-desktop --settings</command></action>
    </item>
    <item label="Change Wallpaper" icon="preferences-desktop-wallpaper">
      <action name="Execute"><command>selkies-desktop --settings wallpaper</command></action>
    </item>
    <item label="Keyboard Shortcuts" icon="preferences-desktop-keyboard">
      <action name="Execute"><command>selkies-desktop --settings shortcuts</command></action>
    </item>
    <separator />
    <menu id="selkies-applications" />
    <menu id="client-list-combined-menu" />
    <separator />
    <item label="Show Desktop" icon="user-desktop">
      <action name="Execute"><command>selkies-desktop --show-desktop</command></action>
    </item>
  </menu>
</openbox_menu>
