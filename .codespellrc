[codespell]
# npm dependencies, lockfiles, local build output (Cargo's target among it),
# generated bundles (the web client's dist/web among them), the translation
# catalog, the TypeScript build caches, the vendored Wayland protocols and
# crates, upstream-native codec patches, and the fuzzers' seed inputs are not
# ours to spell-check.
skip = ./.git,./build,./dist,./target,./tests/tools/protocols,./crates/selkies-rtc/vendor,./crates/selkies-rtc/fuzz/seeds,./crates/pixelflux/fuzz/seeds,./crates/pcmflux/fuzz/seeds,./crates/pixelflux/va-sys/headers,./crates/pixelflux/va-sys/src/bindgen,./crates/pixelflux/codec-sys/headers,./crates/pixelflux/nvcodec-sys/headers,./crates/pixelflux/nvcodec-sys/src/bindgen,./web/*/node_modules,./web/*/dist,./tests/browserstack/node_modules,./tests/browserstack/browserstack-out,./website/node_modules,./website/out,./website/.next,./website/public,*.lock,*.patch,package-lock.json,*.tsbuildinfo,*.min.js,selkies-core.js,translations.ts,*.svg,*.png,*.ico,*.woff,*.woff2
# renderD: DRM render node prefix (renderD128). requestor: X11 selection
# protocol field name. currentY/initialY: pointer coordinate variables.
# chage: the shadow-utils command. anc: SDI ancillary-data region.
# zink: the Mesa OpenGL-on-Vulkan driver. parm: the v4l2_streamparm member.
# datas: PipeWire spa_buffer field (buffer->datas, n_datas). propertyst: the X
# server's propertyst.h header. notin: Kubernetes' NotIn selector operator.
# ue: the exp-Golomb ue(v) syntax element. rightt: the X keysym's name.
# doubleclick: Openbox's DoubleClick mouse action.
ignore-words-list = renderd,requestor,requestors,currenty,initialy,chage,anc,zink,parm,datas,propertyst,notin,ue,rightt,doubleclick,trun,re-declares,retuned
