[codespell]
# npm dependencies, lockfiles, local build output, generated bundles and the
# translation catalogues are not ours to spell-check.
skip = ./.git,./build,./addons/*/node_modules,./addons/*/dist,./website/node_modules,./website/out,./website/.next,./website/public,./src/selkies/selkies_web,*.lock,package-lock.json,*.min.js,selkies-core.js,translations.js,translations-extra.ts,*.svg,*.png,*.ico,*.woff,*.woff2
# renderD: DRM render node prefix (renderD128). requestor: X11 selection
# protocol field name. currentY/initialY: pointer coordinate variables.
# chage: the shadow-utils command. anc: SDI ancillary-data region.
# zink: the Mesa OpenGL-on-Vulkan driver. parm: the v4l2_streamparm member.
ignore-words-list = renderd,requestor,requestors,currenty,initialy,chage,anc,zink,parm
