#
# The AppImage's entry point, at the root of the glibc bundle it carries
# (infra/appimage/build.sh). Run with no arguments it is the server's own
# standalone desktop (crates/selkies/src/commands/standalone.rs), at
# https://localhost:8080. `session` brings up the bundle's own display, buses,
# sound server, and a desktop, and `resize` and `gpu-probe` act on a display
# already up, so those run the server's command as they are. Any other
# arguments are the server's, streaming the display and sound server it is
# pointed at, starting the bundle's Xvfb when that display is not up and its
# PulseAudio when none is listening, as a native install attached to them would.
HERE="$(dirname "$(readlink -f "${0}")")"
SELKIES="${HERE}/bin/selkies"
LIBEXEC="${HERE}/libexec/selkies"

[ "$#" -gt 0 ] || exec "${SELKIES}"
case "$1" in
    session|resize|gpu-probe) exec "${SELKIES}" "$@" ;;
esac
# A help or version query prints and exits, so it starts no display or sound server
for arg in "$@"; do
    case "${arg}" in
        -h|--help|--version) exec "${SELKIES}" "$@" ;;
    esac
done

# The bundled xkb data where the host has none, for the server's keymaps
[ -d /usr/share/X11/xkb ] || export XKB_CONFIG_ROOT="${XKB_CONFIG_ROOT:-${HERE}/share/selkies/xkb}"
# The bundled interposers, for preloading into an application that needs
# gamepads where /dev/uinput is unreachable, or the webcam where no v4l2loopback
# device is; not preloaded here, since selkies itself must see the real devices
export SELKIES_INTERPOSER="${SELKIES_INTERPOSER:-${HERE}/lib/selkies/preload/selkies_input_interposer.so}"
export SELKIES_WEBCAM_INTERPOSER="${SELKIES_WEBCAM_INTERPOSER:-${HERE}/lib/selkies/preload/selkies_v4l2_interposer.so}"

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
export PULSE_SERVER="${PULSE_SERVER:-unix:${XDG_RUNTIME_DIR}/pulse/native}"
export PULSE_RUNTIME_PATH="${PULSE_RUNTIME_PATH:-${XDG_RUNTIME_DIR}/pulse}"
export PIPEWIRE_LATENCY="${PIPEWIRE_LATENCY:-256/48000}"

# Backend toggle, resolved as selkies resolves it: SELKIES_WAYLAND when set
# (blank included), else the legacy PIXELFLUX_WAYLAND, with "true" or "1" in
# any case ahead of a "|locked" suffix. Wayland mode starts its own compositor.
wayland="${SELKIES_WAYLAND-${PIXELFLUX_WAYLAND-}}"
wayland="$(printf '%s' "${wayland%%|*}" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
if [ "${wayland}" != "true" ] && [ "${wayland}" != "1" ]; then
    export DISPLAY="${DISPLAY:-:20}"
    socket="/tmp/.X11-unix/X${DISPLAY#*:}"
    if [ ! -S "${socket}" ]; then
        "${LIBEXEC}/Xvfb" "${DISPLAY}" -screen 0 8192x4096x24 -s 0 -dpms +extension COMPOSITE \
            +extension DAMAGE +extension GLX +extension RANDR +extension RENDER +extension MIT-SHM \
            +extension XFIXES +extension XTEST +render -nolisten tcp -ac \
            > "${XDG_RUNTIME_DIR}/Xvfb_selkies.log" 2>&1 &
        echo 'Waiting for X Socket'
        until [ -S "${socket}" ]; do sleep 0.5; done
        echo 'X Server is ready'
    fi
fi

# The bundle's PulseAudio, with the modules selkies session loads, where no
# sound server is listening
if [ ! -S "${PULSE_SERVER#unix:}" ]; then
    "${LIBEXEC}/pulseaudio" -n --daemonize=no --exit-idle-time=-1 --use-pid-file=no \
        --dl-search-path="${HERE}/lib/selkies/pulse/modules" \
        --load="module-native-protocol-unix auth-anonymous=1 auth-cookie-enabled=0" \
        --load=module-always-sink --log-target="file:${XDG_RUNTIME_DIR}/pulseaudio_selkies.log" &
fi

exec "${SELKIES}" "$@"
