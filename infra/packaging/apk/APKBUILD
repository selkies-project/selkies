pkgname=selkies
pkgver=0.0.0
pkgrel=0
pkgdesc="Low-latency HTML5 remote desktop streaming (WebSocket and WebRTC)"
url="https://github.com/selkies-project/selkies"
arch="x86_64 aarch64"
license="MPL-2.0"
depends="python3 libpulse libxcb libxkbcommon libx11 libva libdrm"
# The payload (/opt/selkies venv staged by infra/packaging/apk.sh) is packed here.
source=""
options="!check"
package() {
    cp -r /pkg-root/opt "$pkgdir"/opt
    cp -r /pkg-root/usr "$pkgdir"/usr
}
