diff -ruN a/src/output-wl.c b/src/output-wl.c
--- a/src/output-wl.c
+++ b/src/output-wl.c
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "output-wl.h"
+#include <string.h>
+#include <wlr/backend/multi.h>
+#include <wlr/backend/wayland.h>
+#include <wlr/types/wlr_output.h>
+#include <wlr/util/log.h>
+#include "labwc.h"
+#include "output.h"
+
+static void
+get_wl_backend(struct wlr_backend *backend, void *data)
+{
+	if (wlr_backend_is_wl(backend)) {
+		struct wlr_backend **wl = data;
+		*wl = backend;
+	}
+}
+
+struct wlr_output *
+output_wl_add(struct server *server)
+{
+	struct wlr_backend *wl_backend = NULL;
+	if (wlr_backend_is_multi(server->backend)) {
+		wlr_multi_for_each_backend(server->backend,
+			get_wl_backend, &wl_backend);
+	} else if (wlr_backend_is_wl(server->backend)) {
+		wl_backend = server->backend;
+	}
+	if (!wl_backend) {
+		wlr_log(WLR_ERROR, "cannot add a screen: no wayland backend");
+		return NULL;
+	}
+	return wlr_wl_output_create(wl_backend);
+}
+
+bool
+output_wl_remove(struct server *server, const char *output_name)
+{
+	int have = 0;
+	struct output *output;
+	wl_list_for_each(output, &server->outputs, link) {
+		if (wlr_output_is_wl(output->wlr_output)) {
+			have++;
+		}
+	}
+	/* The session's last screen is not for removing */
+	if (have <= 1) {
+		return false;
+	}
+	/* Outputs are head-inserted at creation, so the list runs newest first */
+	wl_list_for_each(output, &server->outputs, link) {
+		if (!wlr_output_is_wl(output->wlr_output)) {
+			continue;
+		}
+		if (output_name
+				&& strcmp(output->wlr_output->name, output_name) != 0) {
+			continue;
+		}
+		wlr_output_destroy(output->wlr_output);
+		return true;
+	}
+	return false;
+}
