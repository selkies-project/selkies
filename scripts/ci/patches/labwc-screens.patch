diff -ruN a/include/output-wl.h b/include/output-wl.h
--- a/include/output-wl.h
+++ b/include/output-wl.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef LABWC_OUTPUT_WL_H
+#define LABWC_OUTPUT_WL_H
+
+#include <stdbool.h>
+
+struct server;
+struct wlr_output;
+
+/**
+ * output_wl_add - add a screen on the Wayland backend at runtime, the same
+ * call the backend makes at startup for WLR_WL_OUTPUTS. NULL when the
+ * compositor is not nested (no Wayland backend) or the host refused it.
+ */
+struct wlr_output *output_wl_add(struct server *server);
+
+/**
+ * output_wl_remove - destroy the named Wayland-backend screen, or the newest
+ * one when output_name is NULL. Windows on it are evacuated by the normal
+ * output-destroy path. Refuses to remove the last screen.
+ */
+bool output_wl_remove(struct server *server, const char *output_name);
+
+#endif /* LABWC_OUTPUT_WL_H */
