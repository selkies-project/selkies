# Both Dockerfiles build from the repository root, so keep the context small.
# npm dependencies and every generated bundle are rebuilt inside the image.
.git
# pixelflux and pcmflux are the server's path dependencies, the clones beside the
# sources: their sources go in, their histories and build products do not
**/.git
**/target
pixelflux/build
pcmflux/build
pixelflux/*.egg-info
pcmflux/*.egg-info
**/node_modules
**/dist
**/__pycache__
**/*.pyc
.ruff_cache
**/.next
build/
out/
release/
release-artifacts/
AppDir/
infra/appimage/AppDir/
